{
  "name": "bohemika-provize-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-image-runtime.mjs && node scripts/check-security-config.mjs && next build && node scripts/check-auth-proxy-build.mjs",
    "check:image-runtime": "node scripts/check-image-runtime.mjs",
    "start": "next start",
    "clean": "rm -rf .next",
    "clean:next-cache": "rm -rf .next/cache .next/dev/cache",
    "lint": "eslint",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-bohemika-rules --config firebase.rules-test.json \"vitest run --config vitest.rules.config.ts\"",
    "cashflow:pilot": "firebase emulators:exec --only firestore --project demo-bohemika-cashflow-pilot --config firebase.rules-test.json \"node scripts/cashflow-pilot.mjs --output=/tmp/bohemika-cashflow-pilot.json\"",
    "test:watch": "vitest",
    "mailbox:encrypt-legacy": "node --experimental-strip-types scripts/migrate-mailbox-encryption.mjs",
    "assets:optimize-icons": "node scripts/optimize-public-icons.mjs",
    "generate:homepage-gif": "node scripts/generate-homepage-demo-gif.cjs",
    "generate:homepage-gif:real": "node scripts/generate-homepage-gif-from-screenshots.cjs"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tesseract.js-data/ces": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.19.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "9.15.1",
    "html2canvas-pro": "^2.0.2",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.555.0",
    "next": "16.3.8",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^5.4.530",
    "qrcode": "^1.5.4",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.4.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@next/bundle-analyzer": "16.3.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "gifenc": "^1.0.3",
    "happy-dom": "20.14.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "sharp": "$sharp",
    "protobufjs": "7.6.6",
    "fast-xml-parser": "5.11.2",
    "node-forge": "1.4.0",
    "postcss": "8.5.31",
    "uuid": "11.1.1",
    "@fastify/busboy": "3.2.3",
    "@grpc/grpc-js": "1.14.6",
    "dompurify": "3.4.17",
    "source-map-js": "1.2.2"
  }
}
