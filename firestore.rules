rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function cleanEmail(email) {
      return (email is string && email.matches("^[^/]+$")) ? email : null;
    }

    // Admin s custom claimem `admin: true`
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function normEmail(email) {
      let c = cleanEmail(email);
      return (c is string) ? c.lower() : "";
    }

    function authEmail() {
      return isSignedIn() ? normEmail(request.auth.token.email) : null;
    }

    function isOwner(email) {
      let clean = normEmail(email);
      let me = authEmail();
      return clean != null && me != null && me == clean;
    }

    function authUid() {
      return isSignedIn() ? request.auth.uid : null;
    }

    function isOwnerUid(uid) {
      return authUid() != null && uid is string && authUid() == uid;
    }

    // Vrátí manažera daného uživatele (pokud existuje), jinak prázdný string.
    function managerEmailOf(email) {
      let clean = normEmail(email);
      let safe = clean == "" ? "__missing__" : clean;
      let ref = /databases/$(database)/documents/users/$(safe);
      let snap = get(ref);
      return clean != ""
        && snap.data is map
        ? normEmail(snap.data.managerEmail)
        : "";
    }

    function isDirectManagerOfUserResource() {
      let me = authEmail();
      return me != null
        && me != ""
        && resource != null
        && resource.data is map
        && normEmail(resource.data.managerEmail) == me;
    }

    function isManagerOfUserResource(userEmail) {
      let me = authEmail();
      let m1 = resource != null && resource.data is map
        ? normEmail(resource.data.managerEmail)
        : managerEmailOf(userEmail);
      return me != null
        && me != ""
        && (
          m1 == me ||
          managerEmailOf(m1) == me ||
          managerEmailOf(managerEmailOf(m1)) == me ||
          managerEmailOf(managerEmailOf(managerEmailOf(m1))) == me ||
          managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(m1)))) == me ||
          managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(m1))))) == me ||
          managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(m1)))))) == me ||
          managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(m1))))))) == me
        );
    }

    // Podřízený může číst veřejný profil svého nadřízeného (a nadřízených nad ním),
    // aby šlo při ukládání smlouvy dopočítat managerChain / meziprovize.
    function isSubordinateOfUserResource(userEmail) {
      let me = authEmail();
      let target = normEmail(userEmail);
      let m1 = managerEmailOf(me);
      return me != null
        && me != ""
        && target != ""
        && (
          m1 == target ||
          managerEmailOf(m1) == target ||
          managerEmailOf(managerEmailOf(m1)) == target ||
          managerEmailOf(managerEmailOf(managerEmailOf(m1))) == target ||
          managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(m1)))) == target ||
          managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(m1))))) == target ||
          managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(m1)))))) == target ||
          managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(managerEmailOf(m1))))))) == target
        );
    }

    function isAuthUsersLegacyProfileDoc() {
      return resource != null
        && resource.data is map
        && (
          isAuthEmail(resource.data.email)
          || isOwnerUid(resource.data.userId)
        );
    }

    // Ověří, jestli je přihlášený uživatel v manažerském řetězci - používá pre-computed managerChain z dokumentu
    function isManagerInChain(doc) {
      let me = authEmail();
      return isSignedIn() && doc is map && (
        // Pokud existuje managerChain pole
        (doc.managerChain is list && (
          (doc.managerChain.size() > 0 && normEmail(doc.managerChain[0].email) == me) ||
          (doc.managerChain.size() > 1 && normEmail(doc.managerChain[1].email) == me) ||
          (doc.managerChain.size() > 2 && normEmail(doc.managerChain[2].email) == me) ||
          (doc.managerChain.size() > 3 && normEmail(doc.managerChain[3].email) == me) ||
          (doc.managerChain.size() > 4 && normEmail(doc.managerChain[4].email) == me) ||
          (doc.managerChain.size() > 5 && normEmail(doc.managerChain[5].email) == me) ||
          (doc.managerChain.size() > 6 && normEmail(doc.managerChain[6].email) == me) ||
          (doc.managerChain.size() > 7 && normEmail(doc.managerChain[7].email) == me) ||
          (doc.managerChain.size() > 8 && normEmail(doc.managerChain[8].email) == me) ||
          (doc.managerChain.size() > 9 && normEmail(doc.managerChain[9].email) == me)
        ))
        // Fallback: kontroluj managerEmailSnapshot
        || normEmail(doc.managerEmailSnapshot) == me
      );
    }

    function entryUserMatches(userEmail) {
      return normEmail(request.resource.data.userEmail) == normEmail(userEmail);
    }

    function canEditPositionFields(userEmail) {
      let ref = /databases/$(database)/documents/users/$(normEmail(userEmail));
      return exists(ref) && get(ref).data is map
        ? get(ref).data.canChangePosition != false
        : true;
    }

    function authUserHasAdminFunction() {
      let me = authEmail();
      let clean = (me is string) ? me : "";
      let safe = clean == "" ? "__missing__" : clean;
      let privateRef = /databases/$(database)/documents/usersPrivate/$(safe);
      let publicRef = /databases/$(database)/documents/users/$(safe);
      return clean != ""
        && (
          (
            exists(privateRef)
            && get(privateRef).data is map
            && (
              get(privateRef).data.adminFunction == true
              || get(privateRef).data.adminfunction == true
            )
          )
          || (
            exists(publicRef)
            && get(publicRef).data is map
            && (
              get(publicRef).data.adminFunction == true
              || get(publicRef).data.adminfunction == true
            )
          )
        );
    }

    function isManagerInHierarchyOfResource() {
      let me = authEmail();
      let m1 = resource != null && resource.data is map ? normEmail(resource.data.managerEmail) : "";
      let m2 = managerEmailOf(m1);
      let m3 = managerEmailOf(m2);
      let m4 = managerEmailOf(m3);
      let m5 = managerEmailOf(m4);
      let m6 = managerEmailOf(m5);
      let m7 = managerEmailOf(m6);
      let m8 = managerEmailOf(m7);
      return me != null
        && me != ""
        && (
          m1 == me ||
          m2 == me ||
          m3 == me ||
          m4 == me ||
          m5 == me ||
          m6 == me ||
          m7 == me ||
          m8 == me
        );
    }

    function isPrivilegedSubordinatePositionUpdate() {
      return resource != null
        && authUserHasAdminFunction()
        && isManagerInHierarchyOfResource()
        && resource.data.canChangePosition != false
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["position"]);
    }

    function isAuthEmail(email) {
      return authEmail() != "" && normEmail(email) == authEmail();
    }

    function chainEmail(doc, idx) {
      return (doc.managerChain is list && doc.managerChain.size() > idx)
        ? normEmail(doc.managerChain[idx].email)
        : null;
    }

    function overrideEmail(doc, idx) {
      return (doc.managerOverrides is list && doc.managerOverrides.size() > idx)
        ? normEmail(doc.managerOverrides[idx].email)
        : null;
    }

    function isContractOwnerData(data) {
      return data != null && (
        isAuthEmail(data.userEmail)
        || isOwnerUid(data.userId)
      );
    }

    function sameContractOwner() {
      return normEmail(resource.data.userEmail) == normEmail(request.resource.data.userEmail)
        && resource.data.userId == request.resource.data.userId;
    }

    // čitelnost smlouvy podle uložených údajů (autor, manažeři z chainu/override, manažer snapshot)
    function canReadContractDoc(doc) {
      return isContractOwnerData(doc)
        || isAuthEmail(doc.managerEmailSnapshot)
        || isAuthEmail(chainEmail(doc, 0))
        || isAuthEmail(chainEmail(doc, 1))
        || isAuthEmail(chainEmail(doc, 2))
        || isAuthEmail(chainEmail(doc, 3))
        || isAuthEmail(chainEmail(doc, 4))
        || isAuthEmail(chainEmail(doc, 5))
        || isAuthEmail(chainEmail(doc, 6))
        || isAuthEmail(chainEmail(doc, 7))
        || isAuthEmail(chainEmail(doc, 8))
        || isAuthEmail(chainEmail(doc, 9))
        || isAuthEmail(overrideEmail(doc, 0))
        || isAuthEmail(overrideEmail(doc, 1))
        || isAuthEmail(overrideEmail(doc, 2))
        || isAuthEmail(overrideEmail(doc, 3))
        || isAuthEmail(overrideEmail(doc, 4))
        || isAuthEmail(overrideEmail(doc, 5))
        || isAuthEmail(overrideEmail(doc, 6))
        || isAuthEmail(overrideEmail(doc, 7))
        || isAuthEmail(overrideEmail(doc, 8))
        || isAuthEmail(overrideEmail(doc, 9))
        || isManagerInChain(doc);
    }

    // ověří přístup k dokumentu podle dat v dokumentu (userEmail + manager snapshot/chain)
    function canReadEntryDoc(doc) {
      return doc != null && (
        isAuthEmail(doc.userEmail)
        || isOwnerUid(doc.userId)
        || isAuthEmail(doc.managerEmailSnapshot)
        || isAuthEmail(chainEmail(doc, 0))
        || isAuthEmail(chainEmail(doc, 1))
        || isAuthEmail(chainEmail(doc, 2))
        || isAuthEmail(chainEmail(doc, 3))
        || isAuthEmail(chainEmail(doc, 4))
        || isAuthEmail(chainEmail(doc, 5))
        || isAuthEmail(chainEmail(doc, 6))
        || isAuthEmail(chainEmail(doc, 7))
        || isAuthEmail(chainEmail(doc, 8))
        || isAuthEmail(chainEmail(doc, 9))
        || isAuthEmail(overrideEmail(doc, 0))
        || isAuthEmail(overrideEmail(doc, 1))
        || isAuthEmail(overrideEmail(doc, 2))
        || isAuthEmail(overrideEmail(doc, 3))
        || isAuthEmail(overrideEmail(doc, 4))
        || isAuthEmail(overrideEmail(doc, 5))
        || isAuthEmail(overrideEmail(doc, 6))
        || isAuthEmail(overrideEmail(doc, 7))
        || isAuthEmail(overrideEmail(doc, 8))
        || isAuthEmail(overrideEmail(doc, 9))
        || isManagerInChain(doc)
      );
    }

    function isChangingPositionOrMode() {
      return resource != null && (
        resource.data.position != request.resource.data.position ||
        resource.data.commissionMode != request.resource.data.commissionMode
      );
    }

    function isSettingCanChangeToTrue() {
      return request.resource.data.canChangePosition == true &&
             (resource == null || resource.data.canChangePosition != true);
    }

    function isChangingSensitivePublicUserFields() {
      return resource == null
        ? request.resource.data.keys().hasAny([
            "subscriptionStatus",
            "adminFunction",
            "adminfunction",
            "fcmTokens",
            "pushTokens",
            "notificationTokens",
            "fcmTokensByDevice",
            "pushTokensByDevice"
          ])
        : request.resource.data.diff(resource.data).changedKeys().hasAny([
            "subscriptionStatus",
            "adminFunction",
            "adminfunction",
            "fcmTokens",
            "pushTokens",
            "notificationTokens",
            "fcmTokensByDevice",
            "pushTokensByDevice"
          ]);
    }

    function isChangingRestrictedPrivateUserFields() {
      return resource == null
        ? request.resource.data.keys().hasAny([
            "subscriptionStatus",
            "adminFunction",
            "adminfunction"
          ])
        : request.resource.data.diff(resource.data).changedKeys().hasAny([
            "subscriptionStatus",
            "adminFunction",
            "adminfunction"
          ]);
    }

    function isOwnerPrivateWriteAllowed() {
      let ownerWritablePrivateFields = [
        "fcmTokens",
        "pushTokens",
        "notificationTokens",
        "fcmTokensByDevice",
        "pushTokensByDevice"
      ];
      return !isChangingRestrictedPrivateUserFields()
        && (
          resource == null
            ? request.resource.data.keys().hasOnly(ownerWritablePrivateFields)
            : request.resource.data.diff(resource.data).changedKeys().hasOnly(ownerWritablePrivateFields)
        );
    }

    function isNonEmptyText(value) {
      return value is string && value.matches(".*\\S.*");
    }

    function isValidEntryType(value) {
      return value is string && (value == "contract" || value == "endorsement");
    }

    function isValidProductKey(value) {
      return value is string && value in [
        "neon",
        "flexi",
        "maximaMaxEfekt",
        "pillowInjury",
        "zamex",
        "domex",
        "pillowmajetek",
        "koopmajetekobcan",
        "maxdomov",
        "cppsimplex",
        "cppAuto",
        "slaviaauto",
        "allianzAuto",
        "csobAuto",
        "uniqaAuto",
        "uniqaflotila",
        "pillowAuto",
        "kooperativaAuto",
        "koopcestovko",
        "cppcestovko",
        "axacestovko",
        "comfortcc",
        "cppPPRs",
        "cppPPRbez"
      ];
    }

    function isValidContractNumber(value) {
      return value is string
        && value.matches("^[A-Za-z0-9][A-Za-z0-9._/-]{2,39}$");
    }

    function isReasonableContractTimestamp(value) {
      return value is timestamp
        && value >= timestamp.date(2000, 1, 1)
        && value < timestamp.date(2101, 1, 1);
    }

    function hasValidContractCore(data) {
      return data is map
        && isValidEntryType(data.entryType)
        && isValidProductKey(data.productKey)
        && isNonEmptyText(data.clientName)
        && isValidContractNumber(data.contractNumber)
        && isReasonableContractTimestamp(data.contractSignedDate)
        && isReasonableContractTimestamp(data.policyStartDate)
        && data.policyStartDate >= data.contractSignedDate;
    }

    function contractCoreFieldsChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([
        "entryType",
        "productKey",
        "clientName",
        "contractNumber",
        "contractSignedDate",
        "policyStartDate"
      ]);
    }

    function changedKey(key) {
      return request.resource.data.diff(resource.data).changedKeys().hasAny([key]);
    }

    function hasValidContractCoreUpdate() {
      return (!changedKey("entryType") || isValidEntryType(request.resource.data.entryType))
        && (!changedKey("productKey") || isValidProductKey(request.resource.data.productKey))
        && (!changedKey("clientName") || isNonEmptyText(request.resource.data.clientName))
        && (!changedKey("contractNumber") || isValidContractNumber(request.resource.data.contractNumber))
        && (
          !(changedKey("contractSignedDate") || changedKey("policyStartDate"))
          || (
            isReasonableContractTimestamp(request.resource.data.contractSignedDate)
            && isReasonableContractTimestamp(request.resource.data.policyStartDate)
            && request.resource.data.policyStartDate >= request.resource.data.contractSignedDate
          )
        );
    }

    // ---------- entries (collectionGroup fallback) ----------
    match /{path=**}/entries/{entryId} {
      allow read: if canReadEntryDoc(resource.data) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---------- users ----------
    match /users/{userEmail} {
      // čtení profilu: já / moji nadřízení / moji podřízení
      allow read: if isOwner(userEmail)
                  || isAuthUsersLegacyProfileDoc()
                  || isAdmin()
                  || isDirectManagerOfUserResource()
                  || isManagerOfUserResource(userEmail)
                  || isSubordinateOfUserResource(userEmail);
      // zapisuje majitel nebo admin
      allow create: if ((isOwner(userEmail) && !isChangingSensitivePublicUserFields()) || isAdmin())
        && !isSettingCanChangeToTrue();
      allow update: if (
          (
            (isOwner(userEmail) && !isChangingSensitivePublicUserFields())
            || isAdmin()
          )
          && !isSettingCanChangeToTrue()
          && (!isChangingPositionOrMode() || canEditPositionFields(userEmail) || isAdmin())
        )
        || isPrivilegedSubordinatePositionUpdate();
      allow delete: if isOwner(userEmail) || isAdmin();

      // ---------- entries ----------
      match /entries/{entryId} {
        // čtení povoleno autorovi, jeho nadřízeným (podle snapshotu v dokumentu) a adminu
        allow read: if isOwner(userEmail)
                    || canReadEntryDoc(resource.data)
                    || isAdmin();
        // zapisuje jen vlastník a musí souhlasit userEmail; admin může opravovat/importovat
        // validace dat smlouvy je vynucena na backendu (rules), aby nešla obejít frontend
        allow create: if (
            isOwner(userEmail)
            && entryUserMatches(userEmail)
            && hasValidContractCore(request.resource.data)
          ) || isAdmin();
        allow update: if (
            isOwner(userEmail)
            && entryUserMatches(userEmail)
            && (
              !contractCoreFieldsChanged()
              || hasValidContractCoreUpdate()
            )
          ) || isAdmin();
        allow delete: if isOwner(userEmail) || isAdmin();
      }

      // ---------- calendarEvents ----------
      match /calendarEvents/{eventId} {
        allow read, write: if isOwner(userEmail) || isAdmin();
      }
    }

    // ---------- usersPrivate ----------
    match /usersPrivate/{userEmail} {
      // citlivá profilová data:
      // - subscription/admin flagy mění jen admin/backend
      // - owner může měnit pouze push tokeny
      allow read: if isOwner(userEmail) || isAdmin();
      allow create, update: if (isOwner(userEmail) && isOwnerPrivateWriteAllowed()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- userStats ----------
    match /userStats/{ownerEmail} {
      allow read: if isSignedIn() && (isOwner(ownerEmail) || isAdmin());
      allow create, update, delete: if isOwner(ownerEmail) || isAdmin();

      match /dailyStats/{dayKey} {
        allow read: if isSignedIn() && (isOwner(ownerEmail) || isAdmin());
        allow create, update, delete: if isOwner(ownerEmail) || isAdmin();
      }

      match /monthlySnapshots/{snapId} {
        allow read: if isSignedIn() && (isOwner(ownerEmail) || isAdmin());
        allow create, update, delete: if isOwner(ownerEmail) || isAdmin();
      }
    }

    // ---------- contracts ----------
    match /contracts/{contractId} {
      allow read: if canReadContractDoc(resource.data) || isAdmin();
      allow create: if isContractOwnerData(request.resource.data) || isAdmin();
      allow update: if (isContractOwnerData(resource.data) && sameContractOwner()) || isAdmin();
      allow delete: if isContractOwnerData(resource.data) || isAdmin();
    }

    // ---------- fallback ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
