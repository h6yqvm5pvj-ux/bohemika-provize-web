rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Helpers ----------
    function validRevocation(state) {
      return state.pendingOperations is map && state.pendingOperations.size() == 0
        && state.validAfterSeconds is int && state.validAfterSeconds >= 0
        && state.generation is string && state.generation.matches("^[a-f0-9-]{36}$")
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time >= state.validAfterSeconds
        && (request.auth.token.firebase.sign_in_provider != "custom"
          || request.auth.token.get("app_auth_generation", "") == state.generation);
    }

    function hasUnrevokedAuthentication() {
      let ref = /databases/$(database)/documents/accountBlocks/$(request.auth.uid);
      // Persistent block fields always deny. A revocation-only record permits
      // fresh proof. One shared document preserves the hierarchy's read budget.
      return !exists(ref) || (get(ref).data.keys().hasOnly(["revocation"])
        && validRevocation(get(ref).data.revocation));
    }

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.get("email_verified", false) == true
        && (
          request.auth.token.firebase.get("sign_in_second_factor", "") == "totp"
          || (request.auth.token.firebase.sign_in_provider == "custom"
            && request.auth.token.get("app_totp_enrolled", false) == true)
        )
        // Server-only blocks also invalidate previously issued ID tokens.
        && hasUnrevokedAuthentication();
    }

    function cleanEmail(email) {
      return (email is string && email.matches("^[^/]+$")) ? email : null;
    }

    function normEmail(email) {
      let c = cleanEmail(email);
      return (c is string) ? c.lower() : "";
    }

    // Identity/role helpers rely on isSignedIn() at every allow boundary below.
    function authEmail() {
      return request.auth != null && request.auth.token.email is string
        && request.auth.token.email.matches("^[^/]+$") ? request.auth.token.email.lower() : null;
    }

    // `admin` also marks support accounts; only admin/owner may use full access.
    // Keep legacy admin tokens without adminRole working, reject unknown roles.
    // Vojtech ma samostatne opravneni pro zakladani uctu, ne admin pristup.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.get("admin", false) == true
        && request.auth.token.get("adminRole", "admin") in ["admin", "owner"]
        && authEmail() != "vojtech.mahr@bohemika.eu";
    }

    function isOwnerAdmin() {
      return isAdmin() && request.auth.token.adminRole == "owner";
    }

    function isOwner(email) {
      let clean = normEmail(email);
      let me = authEmail();
      return clean != null && me != null && me == clean;
    }

    function authUid() {
      return request.auth != null ? request.auth.uid : null;
    }

    function isOwnerUid(uid) {
      return authUid() != null && uid is string && authUid() == uid;
    }

    // Vrátí manažera daného uživatele (pokud existuje), jinak prázdný string.
    function managerEmailOf(email) {
      // Callers supply a normalized, nonempty address. Parent links are server
      // controlled; a missing/malformed link denies access. Reference the prior
      // lookup only once here to avoid exponential expression expansion.
      return get(/databases/$(database)/documents/users/$(email)).data.get("managerEmail", "").lower();
    }

    // Pass each parent as a function argument. Deeply reused let expressions
    // can expand past the rules expression limit even when document reads cache.
    function managerChainWithin1(current, target) {
      return (current == target);
    }
    function managerChainWithin2(current, target) {
      return (current == target || managerChainWithin1(managerEmailOf(current), target));
    }
    function managerChainWithin3(current, target) {
      return (current == target || managerChainWithin2(managerEmailOf(current), target));
    }
    function managerChainWithin4(current, target) {
      return (current == target || managerChainWithin3(managerEmailOf(current), target));
    }
    function managerChainWithin5(current, target) {
      return (current == target || managerChainWithin4(managerEmailOf(current), target));
    }
    function managerChainWithin6(current, target) {
      return (current == target || managerChainWithin5(managerEmailOf(current), target));
    }
    function managerChainWithin7(current, target) {
      return (current == target || managerChainWithin6(managerEmailOf(current), target));
    }
    function managerChainContains(current, target) {
      return (current == target || managerChainWithin7(managerEmailOf(current), target));
    }

    function isDirectManagerOfUserResource() {
      let me = authEmail();
      return me != null
        && me != ""
        && resource != null
        && resource.data is map
        && normEmail(resource.data.managerEmail) == me;
    }

    function isManagerOfUserResource(userEmail) {
      let me = authEmail();
      let first = resource != null && resource.data is map
        ? resource.data.get("managerEmail", "") : managerEmailOf(userEmail);
      return me is string && me != "" && normEmail(first) != "" && managerChainContains(normEmail(first), me);
    }

    // Public manager profiles are needed to calculate the stored manager chain.
    function isSubordinateOfUserResource(userEmail) {
      let me = authEmail();
      let target = normEmail(userEmail);
      let first = managerEmailOf(request.auth.token.email.lower());
      return me is string && me != "" && target != ""
        && first != "" && managerChainContains(first, target);
    }

    function isAuthUsersLegacyProfileDoc() {
      return resource != null
        && resource.data is map
        && (
          isAuthEmail(resource.data.email)
          || isOwnerUid(resource.data.get("userId", ""))
        );
    }

    // Ověří, jestli je přihlášený uživatel v manažerském řetězci - používá pre-computed managerChain z dokumentu
    function isManagerInChain(doc) {
      let me = authEmail();
      return isSignedIn() && doc is map && (
        // Pokud existuje managerChain pole
        (doc.managerChain is list && (
          (doc.managerChain.size() > 0 && normEmail(doc.managerChain[0].email) == me) ||
          (doc.managerChain.size() > 1 && normEmail(doc.managerChain[1].email) == me) ||
          (doc.managerChain.size() > 2 && normEmail(doc.managerChain[2].email) == me) ||
          (doc.managerChain.size() > 3 && normEmail(doc.managerChain[3].email) == me) ||
          (doc.managerChain.size() > 4 && normEmail(doc.managerChain[4].email) == me) ||
          (doc.managerChain.size() > 5 && normEmail(doc.managerChain[5].email) == me) ||
          (doc.managerChain.size() > 6 && normEmail(doc.managerChain[6].email) == me) ||
          (doc.managerChain.size() > 7 && normEmail(doc.managerChain[7].email) == me) ||
          (doc.managerChain.size() > 8 && normEmail(doc.managerChain[8].email) == me) ||
          (doc.managerChain.size() > 9 && normEmail(doc.managerChain[9].email) == me)
        ))
        // Fallback: kontroluj managerEmailSnapshot
        || normEmail(doc.managerEmailSnapshot) == me
      );
    }

    function entryUserMatches(userEmail) {
      return normEmail(request.resource.data.userEmail) == normEmail(userEmail);
    }

    function canEditPositionFields(userEmail) {
      let ref = /databases/$(database)/documents/users/$(normEmail(userEmail));
      return exists(ref) && get(ref).data is map
        ? get(ref).data.canChangePosition != false
        : true;
    }

    function isAuthEmail(email) {
      return authEmail() != "" && normEmail(email) == authEmail();
    }

    function chainEmail(doc, idx) {
      return (doc.managerChain is list && doc.managerChain.size() > idx)
        ? normEmail(doc.managerChain[idx].email)
        : null;
    }

    function overrideEmail(doc, idx) {
      return (doc.managerOverrides is list && doc.managerOverrides.size() > idx)
        ? normEmail(doc.managerOverrides[idx].email)
        : null;
    }

    function isContractOwnerData(data) {
      return data != null && (
        isAuthEmail(data.userEmail)
        || isOwnerUid(data.userId)
      );
    }

    function sameContractOwner() {
      return normEmail(resource.data.userEmail) == normEmail(request.resource.data.userEmail)
        && resource.data.userId == request.resource.data.userId;
    }

    // čitelnost smlouvy podle uložených údajů (autor, manažeři z chainu/override, manažer snapshot)
    function canReadContractDoc(doc) {
      // Resolve authenticated identity once. Repeating the full revocation check
      // for every manager can exceed Firestore's expression evaluation limit.
      let me = authEmail();
      return me is string && me != "" && doc is map && (
        normEmail(doc.userEmail) == me
        || doc.userId == request.auth.uid
        || normEmail(doc.managerEmailSnapshot) == me
        || chainEmail(doc, 0) == me
        || chainEmail(doc, 1) == me
        || chainEmail(doc, 2) == me
        || chainEmail(doc, 3) == me
        || chainEmail(doc, 4) == me
        || chainEmail(doc, 5) == me
        || chainEmail(doc, 6) == me
        || chainEmail(doc, 7) == me
        || chainEmail(doc, 8) == me
        || chainEmail(doc, 9) == me
        || overrideEmail(doc, 0) == me
        || overrideEmail(doc, 1) == me
        || overrideEmail(doc, 2) == me
        || overrideEmail(doc, 3) == me
        || overrideEmail(doc, 4) == me
        || overrideEmail(doc, 5) == me
        || overrideEmail(doc, 6) == me
        || overrideEmail(doc, 7) == me
        || overrideEmail(doc, 8) == me
        || overrideEmail(doc, 9) == me
      );
    }

    function canReadEntryDoc(doc) {
      return canReadContractDoc(doc);
    }

    function isOwnerPublicUpdateAllowed() {
      // Everything not explicitly listed is server/admin controlled, including
      // roles, identity, hierarchy, position, subscription and setup/MFA state.
      // Current app profile edits use the validated server API (Admin SDK).
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "fullName", "name", "phoneNumber", "profileAvatar",
        "monthlyGoal", "notifyMinutes", "backgroundColor", "fontTheme",
        "reduceMotion", "notificationSettings", "homeLayout", "homeWidgets",
        "homePerformanceMode", "homeQuickActions"
      ]);
    }

    function isOwnerPrivateWriteAllowed() {
      let ownerWritablePrivateFields = [
        "fcmTokens",
        "pushTokens",
        "notificationTokens",
        "fcmTokensByDevice",
        "pushTokensByDevice"
      ];
      return resource == null
            ? request.resource.data.keys().hasOnly(ownerWritablePrivateFields)
            : request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerWritablePrivateFields);
    }

    function isNonEmptyText(value) {
      return value is string && value.matches(".*\\S.*");
    }

    function isValidEntryType(value) {
      return value is string && (value == "contract" || value == "endorsement");
    }

    function isValidProductKey(value) {
      return value is string && value in [
        "neon",
        "flexi",
        "maximaMaxEfekt",
        "maxcizinkomplex",
        "pillowInjury",
        "zamex",
        "cppbytex",
        "domexneuron",
        "domex",
        "cpphafan",
        "pillowmajetek",
        "koopmajetekobcan",
        "koopfit",
        "koopodzam",
        "kooppmop",
        "maxdomov",
        "cppsimplex",
        "cppAuto",
        "slaviaauto",
        "slaviaflotila",
        "allianzAuto",
        "allianzmujdomov",
        "csobAuto",
        "uniqaAuto",
        "uniqaflotila",
        "pillowAuto",
        "kooperativaAuto",
        "koopflotila",
        "koopcestovko",
        "cppcestovko",
        "axacestovko",
        "comfortcc",
        "conseqzenit",
        "cppPPRs",
        "cppPPRbez"
      ];
    }

    function isValidContractNumber(value) {
      return value is string
        && value.matches("^[A-Za-z0-9][A-Za-z0-9._/-]{2,39}$");
    }

    function isReasonableContractTimestamp(value) {
      return value is timestamp
        && value >= timestamp.date(2000, 1, 1)
        && value < timestamp.date(2101, 1, 1);
    }

    function hasValidContractCore(data) {
      return data is map
        && isValidEntryType(data.entryType)
        && isValidProductKey(data.productKey)
        && isNonEmptyText(data.clientName)
        && isValidContractNumber(data.contractNumber)
        && isReasonableContractTimestamp(data.contractSignedDate)
        && isReasonableContractTimestamp(data.policyStartDate)
        && data.policyStartDate >= data.contractSignedDate;
    }

    function contractCoreFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "entryType",
        "productKey",
        "clientName",
        "contractNumber",
        "contractSignedDate",
        "policyStartDate"
      ]);
    }

    function changedKey(key) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([key]);
    }

    function hasValidContractCoreUpdate() {
      return (!changedKey("entryType") || isValidEntryType(request.resource.data.entryType))
        && (!changedKey("productKey") || isValidProductKey(request.resource.data.productKey))
        && (!changedKey("clientName") || isNonEmptyText(request.resource.data.clientName))
        && (!changedKey("contractNumber") || isValidContractNumber(request.resource.data.contractNumber))
        && (
          !(changedKey("contractSignedDate") || changedKey("policyStartDate"))
          || (
            isReasonableContractTimestamp(request.resource.data.contractSignedDate)
            && isReasonableContractTimestamp(request.resource.data.policyStartDate)
            && request.resource.data.policyStartDate >= request.resource.data.contractSignedDate
          )
        );
    }

    // ---------- entries (collectionGroup fallback) ----------
    match /{path=**}/entries/{entryId} {
      allow read: if isSignedIn() && (isAdmin() || canReadEntryDoc(resource.data));
      allow create, update, delete: if isSignedIn() && (isAdmin());
    }

    // ---------- users ----------
    match /users/{userEmail} {
      // čtení profilu: já / moji nadřízení / moji podřízení
      allow read: if isSignedIn() && (isAdmin()
                  || isOwner(userEmail)
                  || isAuthUsersLegacyProfileDoc()
                  || isDirectManagerOfUserResource()
                  || isManagerOfUserResource(userEmail)
                  || isSubordinateOfUserResource(userEmail));
      // Account lifecycle, roles and hierarchy are managed through server APIs.
      // Disallow self-delete/recreate so protected fields cannot be stripped.
      allow create, delete: if isSignedIn() && (isOwnerAdmin());
      allow update: if isSignedIn() && ((isOwner(userEmail) && isOwnerPublicUpdateAllowed()) || isOwnerAdmin());

      // ---------- entries ----------
      match /entries/{entryId} {
        // čtení povoleno autorovi, jeho nadřízeným (podle snapshotu v dokumentu) a adminu
        allow read: if isSignedIn() && (isAdmin()
                    || isOwner(userEmail)
                    || canReadEntryDoc(resource.data));
        // zápis smluv jen přes backend API (Admin SDK), ne přímo z klienta
        allow create, update, delete: if isSignedIn() && (isAdmin());
      }

      // ---------- calendarEvents ----------
      match /calendarEvents/{eventId} {
        allow read, write: if isSignedIn() && (isOwner(userEmail) || isAdmin());
      }
    }

    // ---------- usersPrivate ----------
    match /usersPrivate/{userEmail} {
      // citlivá profilová data:
      // - subscription/admin flagy mění jen admin/backend
      // - owner může měnit pouze push tokeny
      allow read: if isSignedIn() && (isOwner(userEmail) || isAdmin());
      allow create, update: if isSignedIn() && ((isOwner(userEmail) && isOwnerPrivateWriteAllowed()) || isOwnerAdmin());
      allow delete: if isSignedIn() && (isOwnerAdmin());
    }

    // ---------- userStats ----------
    match /userStats/{ownerEmail} {
      allow read: if isSignedIn() && (isOwner(ownerEmail) || isAdmin());
      allow create, update, delete: if isSignedIn() && (isOwner(ownerEmail) || isAdmin());

      match /dailyStats/{dayKey} {
        allow read: if isSignedIn() && (isOwner(ownerEmail) || isAdmin());
        allow create, update, delete: if isSignedIn() && (isOwner(ownerEmail) || isAdmin());
      }

      match /monthlySnapshots/{snapId} {
        allow read: if isSignedIn() && (isOwner(ownerEmail) || isAdmin());
        allow create, update, delete: if isSignedIn() && (isOwner(ownerEmail) || isAdmin());
      }
    }

    // ---------- contracts ----------
    match /contracts/{contractId} {
      allow read: if isSignedIn() && (isAdmin() || canReadContractDoc(resource.data));
      allow create, update, delete: if isSignedIn() && (isAdmin());
    }

    // ---------- fallback ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
