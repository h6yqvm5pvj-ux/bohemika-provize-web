[debug] [2026-04-18T09:06:00.714Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/bohemikasmlouvy/rulesets {"name":"projects/bohemikasmlouvy/rulesets/d7a22ad2-b7ea-4582-8693-afebb7e1e072","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // ---------- Helpers ----------\n    function isSignedIn() {\n      return request.auth != null && request.auth.token.email != null;\n    }\n\n    function cleanEmail(email) {\n      return (email is string && email.matches(\"^[^/]+$\")) ? email : null;\n    }\n\n    // Admin s custom claimem `admin: true`\n    function isAdmin() {\n      return request.auth != null && request.auth.token.admin == true;\n    }\n\n    function normEmail(email) {\n      let c = cleanEmail(email);\n      return (c is string) ? c.lower() : \"\";\n    }\n\n    function authEmail() {\n      return isSignedIn() ? normEmail(request.auth.token.email) : null;\n    }\n\n    function isOwner(email) {\n      let clean = normEmail(email);\n      let me = authEmail();\n      return clean != null && me != null && me == clean;\n    }\n\n    function authUid() {\n      return isSignedIn() ? request.auth.uid : null;\n    }\n\n    function isOwnerUid(uid) {\n      return authUid() != null && uid is string && authUid() == uid;\n    }\n\n    // Vrátí manažera daného uživatele (pokud existuje), jinak prázdný string.\n    function managerEmailOf(email) {\n      let clean = normEmail(email);\n      let safe = clean == \"\" ? \"__missing__\" : clean;\n      let ref = /databases/$(database)/documents/users/$(safe);\n      let snap = get(ref);\n      return clean != \"\"\n        && snap.data is map\n        ? normEmail(snap.data.managerEmail)\n        : \"\";\n    }\n\n    // Ověří, jestli je přihlášený uživatel v manažerském řetězci - používá pre-computed managerChain z dokumentu\n    function isManagerInChain(doc) {\n      let me = authEmail();\n      return isSignedIn() && doc is map && (\n        // Pokud existuje managerChain pole\n        (doc.managerChain is list && (\n          (doc.managerChain.size() > 0 && normEmail(doc.managerChain[0].email) == me) ||\n          (doc.managerChain.size() > 1 && normEmail(doc.managerChain[1].email) == me) ||\n          (doc.managerChain.size() > 2 && normEmail(doc.managerChain[2].email) == me) ||\n          (doc.managerChain.size() > 3 && normEmail(doc.managerChain[3].email) == me) ||\n          (doc.managerChain.size() > 4 && normEmail(doc.managerChain[4].email) == me) ||\n          (doc.managerChain.size() > 5 && normEmail(doc.managerChain[5].email) == me) ||\n          (doc.managerChain.size() > 6 && normEmail(doc.managerChain[6].email) == me) ||\n          (doc.managerChain.size() > 7 && normEmail(doc.managerChain[7].email) == me) ||\n          (doc.managerChain.size() > 8 && normEmail(doc.managerChain[8].email) == me) ||\n          (doc.managerChain.size() > 9 && normEmail(doc.managerChain[9].email) == me)\n        ))\n        // Fallback: kontroluj managerEmailSnapshot\n        || normEmail(doc.managerEmailSnapshot) == me\n      );\n    }\n\n    function entryUserMatches(userEmail) {\n      return normEmail(request.resource.data.userEmail) == normEmail(userEmail);\n    }\n\n    function canEditPositionFields(userEmail) {\n      let ref = /databases/$(database)/documents/users/$(normEmail(userEmail));\n      return exists(ref) && get(ref).data is map\n        ? get(ref).data.canChangePosition != false\n        : true;\n    }\n\n    function authUserHasAdminFunction() {\n      let me = authEmail();\n      let clean = (me is string) ? me : \"\";\n      let safe = clean == \"\" ? \"__missing__\" : clean;\n      let privateRef = /databases/$(database)/documents/usersPrivate/$(safe);\n      let publicRef = /databases/$(database)/documents/users/$(safe);\n      return clean != \"\"\n        && (\n          (\n            exists(privateRef)\n            && get(privateRef).data is map\n            && (\n              get(privateRef).data.adminFunction == true\n              || get(privateRef).data.adminfunction == true\n            )\n          )\n          || (\n            exists(publicRef)\n            && get(publicRef).data is map\n            && (\n              get(publicRef).data.adminFunction == true\n              || get(publicRef).data.adminfunction == true\n            )\n          )\n        );\n    }\n\n    function isManagerInHierarchyOfResource() {\n      let me = authEmail();\n      let m1 = resource != null && resource.data is map ? normEmail(resource.data.managerEmail) : \"\";\n      let m2 = managerEmailOf(m1);\n      let m3 = managerEmailOf(m2);\n      let m4 = managerEmailOf(m3);\n      let m5 = managerEmailOf(m4);\n      let m6 = managerEmailOf(m5);\n      let m7 = managerEmailOf(m6);\n      let m8 = managerEmailOf(m7);\n      return me != null\n        && me != \"\"\n        && (\n          m1 == me ||\n          m2 == me ||\n          m3 == me ||\n          m4 == me ||\n          m5 == me ||\n          m6 == me ||\n          m7 == me ||\n          m8 == me\n        );\n    }\n\n    function isPrivilegedSubordinatePositionUpdate() {\n      return resource != null\n        && authUserHasAdminFunction()\n        && isManagerInHierarchyOfResource()\n        && resource.data.canChangePosition != false\n        && request.resource.data.diff(resource.data).changedKeys().hasOnly([\"position\"]);\n    }\n\n    function isAuthEmail(email) {\n      return authEmail() != \"\" && normEmail(email) == authEmail();\n    }\n\n    function chainEmail(doc, idx) {\n      return (doc.managerChain is list && doc.managerChain.size() > idx)\n        ? normEmail(doc.managerChain[idx].email)\n        : null;\n    }\n\n    function overrideEmail(doc, idx) {\n      return (doc.managerOverrides is list && doc.managerOverrides.size() > idx)\n        ? normEmail(doc.managerOverrides[idx].email)\n        : null;\n    }\n\n    function isContractOwnerData(data) {\n      return data != null && (\n        isAuthEmail(data.userEmail)\n        || isOwnerUid(data.userId)\n      );\n    }\n\n    function sameContractOwner() {\n      return normEmail(resource.data.userEmail) == normEmail(request.resource.data.userEmail)\n        && resource.data.userId == request.resource.data.userId;\n    }\n\n    // čitelnost smlouvy podle uložených údajů (autor, manažeři z chainu/override, manažer snapshot)\n    function canReadContractDoc(doc) {\n      return isContractOwnerData(doc)\n        || isAuthEmail(doc.managerEmailSnapshot)\n        || isAuthEmail(chainEmail(doc, 0))\n        || isAuthEmail(chainEmail(doc, 1))\n        || isAuthEmail(chainEmail(doc, 2))\n        || isAuthEmail(chainEmail(doc, 3))\n        || isAuthEmail(chainEmail(doc, 4))\n        || isAuthEmail(chainEmail(doc, 5))\n        || isAuthEmail(chainEmail(doc, 6))\n        || isAuthEmail(chainEmail(doc, 7))\n        || isAuthEmail(chainEmail(doc, 8))\n        || isAuthEmail(chainEmail(doc, 9))\n        || isAuthEmail(overrideEmail(doc, 0))\n        || isAuthEmail(overrideEmail(doc, 1))\n        || isAuthEmail(overrideEmail(doc, 2))\n        || isAuthEmail(overrideEmail(doc, 3))\n        || isAuthEmail(overrideEmail(doc, 4))\n        || isAuthEmail(overrideEmail(doc, 5))\n        || isAuthEmail(overrideEmail(doc, 6))\n        || isAuthEmail(overrideEmail(doc, 7))\n        || isAuthEmail(overrideEmail(doc, 8))\n        || isAuthEmail(overrideEmail(doc, 9))\n        || isManagerInChain(doc);\n    }\n\n    // ověří přístup k dokumentu podle dat v dokumentu (userEmail + manager snapshot/chain)\n    function canReadEntryDoc(doc) {\n      return doc != null && (\n        isAuthEmail(doc.userEmail)\n        || isOwnerUid(doc.userId)\n        || isAuthEmail(doc.managerEmailSnapshot)\n        || isAuthEmail(chainEmail(doc, 0))\n        || isAuthEmail(chainEmail(doc, 1))\n        || isAuthEmail(chainEmail(doc, 2))\n        || isAuthEmail(chainEmail(doc, 3))\n        || isAuthEmail(chainEmail(doc, 4))\n        || isAuthEmail(chainEmail(doc, 5))\n        || isAuthEmail(chainEmail(doc, 6))\n        || isAuthEmail(chainEmail(doc, 7))\n        || isAuthEmail(chainEmail(doc, 8))\n        || isAuthEmail(chainEmail(doc, 9))\n        || isAuthEmail(overrideEmail(doc, 0))\n        || isAuthEmail(overrideEmail(doc, 1))\n        || isAuthEmail(overrideEmail(doc, 2))\n        || isAuthEmail(overrideEmail(doc, 3))\n        || isAuthEmail(overrideEmail(doc, 4))\n        || isAuthEmail(overrideEmail(doc, 5))\n        || isAuthEmail(overrideEmail(doc, 6))\n        || isAuthEmail(overrideEmail(doc, 7))\n        || isAuthEmail(overrideEmail(doc, 8))\n        || isAuthEmail(overrideEmail(doc, 9))\n        || isManagerInChain(doc)\n      );\n    }\n\n    function isChangingPositionOrMode() {\n      return resource != null && (\n        resource.data.position != request.resource.data.position ||\n        resource.data.commissionMode != request.resource.data.commissionMode\n      );\n    }\n\n    function isSettingCanChangeToTrue() {\n      return request.resource.data.canChangePosition == true &&\n             (resource == null || resource.data.canChangePosition != true);\n    }\n\n    function isNonEmptyText(value) {\n      return value is string && value.matches(\".*\\\\S.*\");\n    }\n\n    function isValidEntryType(value) {\n      return value is string && (value == \"contract\" || value == \"endorsement\");\n    }\n\n    function isValidProductKey(value) {\n      return value is string && value in [\n        \"neon\",\n        \"flexi\",\n        \"maximaMaxEfekt\",\n        \"pillowInjury\",\n        \"zamex\",\n        \"domex\",\n        \"koopmajetekobcan\",\n        \"maxdomov\",\n        \"cppsimplex\",\n        \"cppAuto\",\n        \"slaviaauto\",\n        \"allianzAuto\",\n        \"csobAuto\",\n        \"uniqaAuto\",\n        \"uniqaflotila\",\n        \"pillowAuto\",\n        \"kooperativaAuto\",\n        \"cppcestovko\",\n        \"axacestovko\",\n        \"comfortcc\",\n        \"cppPPRs\",\n        \"cppPPRbez\"\n      ];\n    }\n\n    function isValidContractNumber(value) {\n      return value is string\n        && value.matches(\"^[A-Za-z0-9][A-Za-z0-9._/-]{2,39}$\");\n    }\n\n    function isReasonableContractTimestamp(value) {\n      return value is timestamp\n        && value >= timestamp.date(2000, 1, 1)\n        && value < timestamp.date(2101, 1, 1);\n    }\n\n    function hasValidContractCore(data) {\n      return data is map\n        && isValidEntryType(data.entryType)\n        && isValidProductKey(data.productKey)\n        && isNonEmptyText(data.clientName)\n        && isValidContractNumber(data.contractNumber)\n        && isReasonableContractTimestamp(data.contractSignedDate)\n        && isReasonableContractTimestamp(data.policyStartDate)\n        && data.policyStartDate >= data.contractSignedDate;\n    }\n\n    function contractCoreFieldsChanged() {\n      return request.resource.data.diff(resource.data).changedKeys().hasAny([\n        \"entryType\",\n        \"productKey\",\n        \"clientName\",\n        \"contractNumber\",\n        \"contractSignedDate\",\n        \"policyStartDate\"\n      ]);\n    }\n\n    function changedKey(key) {\n      return request.resource.data.diff(resource.data).changedKeys().hasAny([key]);\n    }\n\n    function hasValidContractCoreUpdate() {\n      return (!changedKey(\"entryType\") || isValidEntryType(request.resource.data.entryType))\n        && (!changedKey(\"productKey\") || isValidProductKey(request.resource.data.productKey))\n        && (!changedKey(\"clientName\") || isNonEmptyText(request.resource.data.clientName))\n        && (!changedKey(\"contractNumber\") || isValidContractNumber(request.resource.data.contractNumber))\n        && (\n          !(changedKey(\"contractSignedDate\") || changedKey(\"policyStartDate\"))\n          || (\n            isReasonableContractTimestamp(request.resource.data.contractSignedDate)\n            && isReasonableContractTimestamp(request.resource.data.policyStartDate)\n            && request.resource.data.policyStartDate >= request.resource.data.contractSignedDate\n          )\n        );\n    }\n\n    // ---------- entries (collectionGroup fallback) ----------\n    match /{path=**}/entries/{entryId} {\n      allow read: if canReadEntryDoc(resource.data) || isAdmin();\n      allow create, update, delete: if isAdmin();\n    }\n\n    // ---------- users ----------\n    match /users/{userEmail} {\n      // čtení profilu umožníme všem přihlášeným, aby fungovaly managerChain lookupy\n      allow read: if isSignedIn();\n      // zapisuje majitel nebo admin\n      allow create: if (isOwner(userEmail) || isAdmin()) && !isSettingCanChangeToTrue();\n      allow update: if (\n          (isOwner(userEmail) || isAdmin())\n          && !isSettingCanChangeToTrue()\n          && (!isChangingPositionOrMode() || canEditPositionFields(userEmail) || isAdmin())\n        )\n        || isPrivilegedSubordinatePositionUpdate();\n      allow delete: if isOwner(userEmail) || isAdmin();\n\n      // ---------- entries ----------\n      match /entries/{entryId} {\n        // čtení povoleno autorovi, jeho nadřízeným (podle snapshotu v dokumentu) a adminu\n        allow read: if isOwner(userEmail)\n                    || canReadEntryDoc(resource.data)\n                    || isAdmin();\n        // zapisuje jen vlastník a musí souhlasit userEmail; admin může opravovat/importovat\n        // validace dat smlouvy je vynucena na backendu (rules), aby nešla obejít frontend\n        allow create: if (\n            isOwner(userEmail)\n            && entryUserMatches(userEmail)\n            && hasValidContractCore(request.resource.data)\n          ) || isAdmin();\n        allow update: if (\n            isOwner(userEmail)\n            && entryUserMatches(userEmail)\n            && (\n              !contractCoreFieldsChanged()\n              || hasValidContractCoreUpdate()\n            )\n          ) || isAdmin();\n        allow delete: if isOwner(userEmail) || isAdmin();\n      }\n\n      // ---------- calendarEvents ----------\n      match /calendarEvents/{eventId} {\n        allow read, write: if isOwner(userEmail) || isAdmin();\n      }\n    }\n\n    // ---------- usersPrivate ----------\n    match /usersPrivate/{userEmail} {\n      // citlivá profilová data (subscription/admin flags/push tokeny apod.)\n      allow read, create, update, delete: if isOwner(userEmail) || isAdmin();\n    }\n\n    // ---------- userStats ----------\n    match /userStats/{ownerEmail} {\n      allow read: if isSignedIn() && (isOwner(ownerEmail) || isAdmin());\n      allow create, update, delete: if isOwner(ownerEmail) || isAdmin();\n\n      match /dailyStats/{dayKey} {\n        allow read: if isSignedIn() && (isOwner(ownerEmail) || isAdmin());\n        allow create, update, delete: if isOwner(ownerEmail) || isAdmin();\n      }\n\n      match /monthlySnapshots/{snapId} {\n        allow read: if isSignedIn() && (isOwner(ownerEmail) || isAdmin());\n        allow create, update, delete: if isOwner(ownerEmail) || isAdmin();\n      }\n    }\n\n    // ---------- contracts ----------\n    match /contracts/{contractId} {\n      allow read: if canReadContractDoc(resource.data) || isAdmin();\n      allow create: if isContractOwnerData(request.resource.data) || isAdmin();\n      allow update: if (isContractOwnerData(resource.data) && sameContractOwner()) || isAdmin();\n      allow delete: if isContractOwnerData(resource.data) || isAdmin();\n    }\n\n    // ---------- fallback ----------\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"/Users/jakubrauscher/bohemika-provize-web/firestore.rules"}]},"createTime":"2026-04-18T09:06:00.651391Z","metadata":{"services":["cloud.firestore"]}}
