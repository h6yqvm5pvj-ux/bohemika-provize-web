+++ b/scripts/cashflow-worker/fixtures.ts
@@ -0,0 +1,162 @@
+import type { CashflowSnapshot } from "../../src/app/cashflow/computeCashflow";
+import type { CashflowViewOptions } from "../../src/app/cashflow/buildCashflowView";
+import type {
+  CashflowCommissionStatementSummary,
+  EntryDoc,
+} from "../../src/app/cashflow/types";
+import type { PaymentFrequency, Product } from "../../src/app/types/domain";
+
+export type WorkerFixture = {
+  snapshot: CashflowSnapshot;
+  statements: CashflowCommissionStatementSummary[];
+};
+
+export type WorkerFilterCase = {
+  id: string;
+  label: string;
+  options: CashflowViewOptions;
+};
+
+const defaultOptions: CashflowViewOptions = {
+  scopeFilter: "combined",
+  productFilter: "all",
+  tipsterMode: false,
+  showPastYears: false,
+  intelligentPredictionEnabled: false,
+  contractNumberQuery: "",
+};
+
+export const WORKER_FILTER_CASES: readonly WorkerFilterCase[] = [
+  { id: "combined", label: "Vlastní a týmové smlouvy", options: { ...defaultOptions } },
+  { id: "own", label: "Pouze vlastní smlouvy", options: { ...defaultOptions, scopeFilter: "own" } },
+  { id: "team", label: "Pouze týmové smlouvy", options: { ...defaultOptions, scopeFilter: "team" } },
+  { id: "auto", label: "Pojištění vozidel", options: { ...defaultOptions, productFilter: "auto" } },
+  { id: "life", label: "Životní pojištění", options: { ...defaultOptions, productFilter: "life" } },
+  { id: "tip", label: "Pouze TIP provize", options: { ...defaultOptions, productFilter: "tip" } },
+  { id: "history", label: "Včetně minulých let", options: { ...defaultOptions, showPastYears: true } },
+  { id: "prediction", label: "Inteligentní predikce", options: { ...defaultOptions, intelligentPredictionEnabled: true } },
+  { id: "search", label: "Vyhledání smlouvy 100000", options: { ...defaultOptions, contractNumberQuery: "100000" } },
+];
+
+const products: readonly Product[] = ["cppAuto", "kooperativaAuto", "pillowAuto", "neon", "flexi"];
+const frequencies: readonly PaymentFrequency[] = ["monthly", "quarterly", "semiannual", "annual"];
+const ownerEmail = "advisor@example.test";
+
+const isoDay = (date: Date): string =>
+  `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
+
+/**
+ * Synthetic browser-only inputs. Same count/asOf/local time zone produces the
+ * same portfolio without clock reads, randomness, network access or credentials.
+ * contractCount counts contracts; TIP payouts and statements are additional.
+ */
+export function makeWorkerFixture(contractCount: number, asOf: Date): WorkerFixture {
+  if (!Number.isInteger(contractCount) || contractCount < 1 || contractCount > 1000 ||
+    !(asOf instanceof Date) || !Number.isFinite(asOf.getTime())) {
+    throw new Error("Synthetic fixtures require 1–1000 contracts and a valid asOf date.");
+  }
+
+  const snapshot: CashflowSnapshot = {
+    email: ownerEmail,
+    myPosition: "manazer8",
+    myCommissionMode: "standard",
+    hasAnyTeam: contractCount >= 4,
+    ownEntries: [],
+    teamEntriesRaw: [],
+    tipPayouts: [],
+    // Subscriptions require a production owner identity in the shared calculator.
+    // This fixture keeps every identity synthetic and does not bypass that rule.
+    subscriptionPayments: [],
+  };
+  const contracts: EntryDoc[] = [];
+
+  for (let index = 0; index < contractCount; index++) {
+    const team = index % 4 === 3;
+    const productKey = products[index % products.length];
+    const life = productKey === "neon" || productKey === "flexi";
+    const startDate = new Date(asOf.getFullYear(), asOf.getMonth() - 1 - index % 36, 1 + index % 27);
+    const immediateAmount = life ? 1200 + index % 80 * 12 : 120 + index % 80 * 3;
+    const items = life
+      ? [
+          { code: "A101", title: "Okamžitá provize", amount: immediateAmount },
+          { code: "B101-B104", title: "Následná provize (2.–5. rok)", amount: 30 + index % 10 },
+          { code: "B201-B206", title: "Pečovatelská provize (5.–10. rok)", amount: 15 + index % 5 },
+        ]
+      : [{ code: "A101", title: "Okamžitá provize", amount: immediateAmount }];
+    const entry: EntryDoc = {
+      id: `contract-${String(index).padStart(4, "0")}`,
+      userEmail: team ? `member-${Math.floor(index / 4) % 8}@example.test` : ownerEmail,
+      productKey,
+      frequencyRaw: frequencies[(index + Math.floor(index / products.length)) % frequencies.length],
+      contractNumber: String(100000 + index),
+      clientName: `Syntetický klient ${index + 1}`,
+      contractSignedDate: new Date(startDate.getFullYear(), startDate.getMonth(), startDate.getDate() - 3),
+      policyStartDate: startDate,
+      position: "poradce3",
+      ownerCurrentPosition: "poradce3",
+      commissionMode: "standard",
+      status: "active",
+      inputAmount: life ? 1000 + index % 40 * 25 : 6000 + index % 80 * 100,
+      items,
+      total: items.reduce((sum, item) => sum + item.amount, 0),
+    };
+    if (team) {
+      const overrideItems = items.map(item => ({ ...item, amount: Math.round(item.amount * 0.2 * 100) / 100 }));
+      entry.managerOverrides = [{
+        email: ownerEmail,
+        position: "manazer8",
+        commissionMode: "standard",
+        items: overrideItems,
+        total: overrideItems.reduce((sum, item) => sum + item.amount, 0),
+      }];
+    }
+    (team ? snapshot.teamEntriesRaw : snapshot.ownEntries).push(entry);
+    contracts.push(entry);
+  }
+
+  snapshot.tipPayouts = Array.from({ length: Math.max(3, Math.ceil(contractCount / 25)) }, (_, index) => ({
+    id: `tip-${index}`,
+    payoutDate: new Date(asOf.getFullYear(), asOf.getMonth() + index % 6, 25).getTime(),
+    amount: 150 + index % 20 * 15,
+    clientName: `Syntetický TIP ${index + 1}`,
+    sourceOwnerEmail: `member-${index % 8}@example.test`,
+    productKey: products[index % products.length],
+  }));
+
+  const statementCount = Math.max(3, Math.min(24, Math.ceil(contractCount / 40)));
+  const paidContractsPerStatement = Math.min(contractCount, 30, Math.max(2, Math.ceil(contractCount / 30)));
+  const statements = Array.from({ length: statementCount }, (_, index): CashflowCommissionStatementSummary => {
+    const date = new Date(asOf.getFullYear(), asOf.getMonth() - index - 1, 24);
+    const paidEntries = Array.from({ length: paidContractsPerStatement }, (_, row) => contracts[(row * 7 + index) % contracts.length]);
+    const commissionTotal = paidEntries.reduce((sum, entry) => sum + (
+      entry.managerOverrides?.[0]?.items[0]?.amount ?? entry.items?.[0]?.amount ?? 0
+    ), 0);
+    return {
+      id: `statement-${index}`,
+      fileName: `synthetic-statement-${index}.html`,
+      statementNumber: `SYN-${index + 1}`,
+      statementDate: `${date.getDate()}.${date.getMonth() + 1}.${date.getFullYear()}`,
+      period: `${date.getMonth() + 1}/${date.getFullYear()}`,
+      advisorNumber: "synthetic",
+      periodStartMs: new Date(date.getFullYear(), date.getMonth(), 1).getTime(),
+      periodEndMs: new Date(date.getFullYear(), date.getMonth() + 1, 0).getTime(),
+      statementDateMs: date.getTime(),
+      // Same unpadded month key as the current cashflow view regression fixtures.
+      payoutMonthKey: `${date.getFullYear()}-${date.getMonth() + 1}`,
+      paidContractNumbers: paidEntries.map(entry => entry.contractNumber!),
+      paidCommissionKeys: paidEntries.map(entry => `${entry.contractNumber}:A101`),
+      commissionTotal,
+      payoutTotal: commissionTotal,
+      otherPaymentsTotal: 0,
+      managerCommissionTotal: 0,
+      createdAtMs: date.getTime(),
+      updatedAtMs: date.getTime(),
+    };
+  });
+
+  // Keep date strings represented too, as real API inputs contain both formats.
+  snapshot.ownEntries.forEach((entry, index) => {
+    if (index % 3 === 0) entry.policyStartDate = isoDay(entry.policyStartDate as Date);
+  });
+  return { snapshot, statements };
+}
diff --git a/scripts/cashflow-worker/generate-reference.mjs b/scripts/cashflow-worker/generate-reference.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/cashflow-worker/generate-reference.mjs
@@ -0,0 +1,172 @@
+// Local, repeatable extraction from the immutable production export. No app edits.
+import { createHash } from "node:crypto";
+import { readFileSync, writeFileSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import ts from "typescript";
+
+const directory = path.dirname(fileURLToPath(import.meta.url));
+export const defaultBase = path.resolve(directory, "../../../base");
+const printer = ts.createPrinter({ newLine: ts.NewLineKind.LineFeed });
+const text = (node, source) => printer.printNode(ts.EmitHint.Unspecified, node, source);
+const assert = (condition, message) => { if (!condition) throw new Error(message); };
+const identifiers = node => {
+  const names = new Set();
+  const visit = child => { if (ts.isIdentifier(child)) names.add(child.text); ts.forEachChild(child, visit); };
+  visit(node);
+  return names;
+};
+const declarations = statements => {
+  const result = new Map();
+  for (const statement of statements) {
+    if (ts.isVariableStatement(statement)) {
+      for (const declaration of statement.declarationList.declarations) {
+        if (ts.isIdentifier(declaration.name)) result.set(declaration.name.text, { node: declaration, statement });
+      }
+    } else if ((ts.isTypeAliasDeclaration(statement) || ts.isFunctionDeclaration(statement)) && statement.name) {
+      result.set(statement.name.text, { node: statement, statement });
+    }
+  }
+  return result;
+};
+const dependencies = (roots, available, boundary = new Set()) => {
+  const selected = new Set();
+  const visit = node => {
+    for (const name of identifiers(node)) {
+      if (boundary.has(name)) continue;
+      const found = available.get(name);
+      if (found && !selected.has(found.statement)) {
+        selected.add(found.statement);
+        visit(found.node);
+      }
+    }
+  };
+  roots.forEach(visit);
+  return selected;
+};
+
+export function generateReference(baseDirectory = defaultBase) {
+  const readSource = relative => {
+    const name = path.join(baseDirectory, relative);
+    const sourceText = readFileSync(name, "utf8");
+    return ts.createSourceFile(name, sourceText, ts.ScriptTarget.Latest, true, relative.endsWith(".tsx") ? ts.ScriptKind.TSX : ts.ScriptKind.TS);
+  };
+  const hook = readSource("src/app/cashflow/useCashflowData.ts");
+  const page = readSource("src/app/cashflow/page.tsx");
+  const hookFunction = hook.statements.find(node => ts.isFunctionDeclaration(node) && node.name?.text === "useCashflowData");
+  const pageFunction = page.statements.find(node => ts.isFunctionDeclaration(node) && node.name?.text === "CashflowPage");
+  assert(hookFunction?.body && pageFunction?.body, "Production hook/page declaration changed");
+
+  const hookMemos = hookFunction.body.statements.flatMap(statement => ts.isVariableStatement(statement)
+    ? [...statement.declarationList.declarations].filter(declaration =>
+      ts.isObjectBindingPattern(declaration.name) && declaration.name.elements.some(item => item.name.getText(hook) === "cashflowItems"))
+    : []);
+  assert(hookMemos.length === 1, "Expected one cashflow calculation binding");
+  const memo = hookMemos[0].initializer;
+  assert(memo && ts.isCallExpression(memo) && memo.expression.getText(hook) === "useMemo", "Calculation must remain a useMemo callback");
+  const callback = memo.arguments[0];
+  assert(ts.isArrowFunction(callback) && ts.isBlock(callback.body), "Expected a block calculation callback");
+  let clocksRemoved = 0;
+  let debugRemoved = 0;
+  const bodyStatements = callback.body.statements.filter(statement => {
+    if (ts.isVariableStatement(statement) && statement.declarationList.declarations.length === 1) {
+      const declaration = statement.declarationList.declarations[0];
+      if (ts.isIdentifier(declaration.name) && declaration.name.text === "asOf") {
+        assert(declaration.initializer && ts.isNewExpression(declaration.initializer) && declaration.initializer.expression.getText(hook) === "Date" && declaration.initializer.arguments?.length === 0, "Unexpected hook clock");
+        clocksRemoved += 1;
+        return false;
+      }
+    }
+    if (ts.isIfStatement(statement) && statement.expression.getText(hook) === 'process.env.NODE_ENV !== "production"') {
+      assert(statement.thenStatement.getText(hook).includes('console.info("[cashflow-debug]"'), "Unexpected non-production branch");
+      debugRemoved += 1;
+      return false;
+    }
+    return true;
+  });
+  assert(clocksRemoved === 1 && debugRemoved === 1, "Expected exactly one captured clock and one debug-only block");
+  const hookBody = ts.factory.updateBlock(callback.body, bodyStatements);
+  const hookSupport = dependencies([hookBody], declarations(hook.statements));
+
+  const pageDeclarations = declarations(pageFunction.body.statements);
+  const monthGroups = pageDeclarations.get("monthGroups");
+  assert(monthGroups, "Missing page monthGroups");
+  const boundary = new Set([
+    "cashflowItems", "commissionStatements", "scopeFilter", "productFilter", "isTipsterMode",
+    "showPastYears", "intelligentPredictionEnabled", "contractNumberQuery",
+  ]);
+  const pageSupport = dependencies([monthGroups.node], pageDeclarations, boundary);
+  pageSupport.add(monthGroups.statement);
+  const pageStatements = pageFunction.body.statements.filter(statement => pageSupport.has(statement));
+  const transformations = { hookClock: clocksRemoved, debugOnlyBlock: debugRemoved, useMemo: 0, pastFilters: 0, statementPastFilter: 0, predictionClock: 0 };
+  const rewritePage = context => {
+    const visit = node => {
+      if (ts.isCallExpression(node) && ts.isIdentifier(node.expression)) {
+        const name = node.expression.text;
+        if (name === "useMemo") {
+          assert(node.arguments.length === 2 && ts.isArrowFunction(node.arguments[0]), "Unexpected page memo");
+          transformations.useMemo += 1;
+          return ts.factory.createCallExpression(ts.factory.createParenthesizedExpression(ts.visitNode(node.arguments[0], visit)), undefined, []);
+        }
+        if (name === "filterPastItems" || name === "filterPastStatementMonths") {
+          assert(node.arguments.length === 2, "Unexpected page period filter clock");
+          if (name === "filterPastItems") transformations.pastFilters += 1;
+          else transformations.statementPastFilter += 1;
+          return ts.factory.updateCallExpression(node, node.expression, node.typeArguments, [...node.arguments, ts.factory.createIdentifier("asOf")]);
+        }
+        if (name === "applyIntelligentCashflowPrediction") {
+          const argument = node.arguments[0];
+          assert(node.arguments.length === 1 && ts.isObjectLiteralExpression(argument) && !argument.properties.some(item => item.name?.getText(page) === "today"), "Unexpected page prediction clock");
+          transformations.predictionClock += 1;
+          return ts.factory.updateCallExpression(node, node.expression, node.typeArguments, [ts.factory.updateObjectLiteralExpression(argument, [...argument.properties, ts.factory.createPropertyAssignment("today", ts.factory.createIdentifier("asOf"))])]);
+        }
+      }
+      return ts.visitEachChild(node, visit, context);
+    };
+    return node => ts.visitNode(node, visit);
+  };
+  const transformed = ts.transform(ts.factory.createBlock(pageStatements), [rewritePage]);
+  const pageBody = transformed.transformed[0];
+  assert(transformations.useMemo === 10 && transformations.pastFilters === 2 && transformations.statementPastFilter === 1 && transformations.predictionClock === 1, "Page calculation graph/clock changed; review before regenerating");
+
+  const hookNames = new Set([...identifiers(hookBody), ...[...hookSupport].flatMap(node => [...identifiers(node)])]);
+  const pageNames = identifiers(pageBody);
+  pageNames.add("MonthGroup");
+  const imports = new Map();
+  for (const [source, names] of [[hook, hookNames], [page, pageNames]]) {
+    for (const statement of source.statements) {
+      if (!ts.isImportDeclaration(statement) || !statement.importClause?.namedBindings || !ts.isNamedImports(statement.importClause.namedBindings)) continue;
+      let moduleName = statement.moduleSpecifier.text;
+      if (moduleName.startsWith(".")) moduleName = `@/${path.relative(path.join(baseDirectory, "src"), path.resolve(path.dirname(source.fileName), moduleName)).split(path.sep).join("/")}`;
+      for (const specifier of statement.importClause.namedBindings.elements) {
+        if (!names.has(specifier.name.text)) continue;
+        const value = { moduleName, imported: specifier.propertyName?.text ?? specifier.name.text, local: specifier.name.text, typeOnly: statement.importClause.isTypeOnly || specifier.isTypeOnly };
+        const prior = imports.get(value.local);
+        assert(!prior || JSON.stringify(prior) === JSON.stringify(value), `Ambiguous extracted import ${value.local}`);
+        imports.set(value.local, value);
+      }
+    }
+  }
+  assert(!["useMemo", "useEffect", "useState", "auth"].some(name => imports.has(name)), "Reference must not import React state or Firebase");
+  const groupedImports = new Map();
+  for (const item of imports.values()) {
+    const specifier = `${item.typeOnly ? "type " : ""}${item.imported}${item.imported !== item.local ? ` as ${item.local}` : ""}`;
+    groupedImports.set(item.moduleName, [...(groupedImports.get(item.moduleName) ?? []), specifier]);
+  }
+  const provenance = {
+    sources: Object.fromEntries(["src/app/cashflow/useCashflowData.ts", "src/app/cashflow/page.tsx", "src/app/cashflow/generator.ts", "src/app/cashflow/helpers.ts"].map(name => [name, createHash("sha256").update(readFileSync(path.join(baseDirectory, name))).digest("hex")])),
+    transformations,
+    note: "Production calculation callbacks extracted with TypeScript AST; common business helpers remain shared. asOf freezes only ambient clocks. React memoization and rendering are outside this reference.",
+  };
+  const output = `// Generated by generate-reference.mjs from immutable base; do not hand edit.\n// Local benchmark only. No app source, authentication, networking or payload logging.\n${[...groupedImports].map(([name, specs]) => `import { ${specs.join(", ")} } from ${JSON.stringify(name)};`).join("\n")}\nimport { computeCashflow, type CashflowSnapshot } from "@/app/cashflow/computeCashflow";\nimport { buildCashflowView, type CashflowViewOptions } from "@/app/cashflow/buildCashflowView";\n\nexport const REFERENCE_PROVENANCE = ${JSON.stringify(provenance, null, 2)} as const;\n\n${hook.statements.filter(statement => hookSupport.has(statement)).map(statement => text(statement, hook)).join("\n\n")}\n\nexport function runReferenceItems(snapshot: CashflowSnapshot, options: CashflowViewOptions, asOf: Date): CashflowItem[] {\n  const { scopeFilter, productFilter, tipsterMode } = options;\n  const enabled = true;\n  const snapshotMatchesCurrentUser = true;\n  const result = (() => ${text(hookBody, hook)})();\n  return result.cashflowItems;\n}\n\nexport function runReferenceView(cashflowItems: CashflowItem[], commissionStatements: CashflowCommissionStatementSummary[], options: CashflowViewOptions, asOf: Date): MonthGroup[] {\n  const { scopeFilter, productFilter, tipsterMode: isTipsterMode, showPastYears, intelligentPredictionEnabled, contractNumberQuery } = options;\n${pageBody.statements.map(statement => text(statement, page)).join("\n")}\n  return monthGroups;\n}\n\nexport function runReference(snapshot: CashflowSnapshot, statements: CashflowCommissionStatementSummary[], options: CashflowViewOptions, asOf: Date): { items: CashflowItem[]; months: MonthGroup[] } {\n  const items = runReferenceItems(snapshot, options, asOf);\n  return { items, months: runReferenceView(items, statements, options, asOf) };\n}\n\nexport function runCandidate(snapshot: CashflowSnapshot, statements: CashflowCommissionStatementSummary[], options: CashflowViewOptions, asOf: Date): { items: CashflowItem[]; months: MonthGroup[] } {\n  const items = computeCashflow(snapshot, { ...options, asOf });\n  return { items, months: buildCashflowView(items, statements, options, asOf) };\n}\n`;
+  transformed.dispose();
+  return output;
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const target = path.join(directory, "reference.ts");
+  const output = generateReference();
+  if (process.argv.includes("--check")) assert(readFileSync(target, "utf8") === output, "Reference differs from immutable source extraction");
+  else writeFileSync(target, output);
+  process.stdout.write(process.argv.includes("--check") ? "Reference matches immutable AST extraction.\n" : "Reference generated from immutable source AST.\n");
+}
