+import { describe, expect, it } from "vitest";
+import { computeCashflow } from "../../src/app/cashflow/computeCashflow";
+import { buildCashflowView } from "../../src/app/cashflow/buildCashflowView";
+import { makeWorkerFixture, WORKER_FILTER_CASES } from "./fixtures";
+
+const asOf = new Date(2026, 8, 12, 12);
+
+describe("synthetic browser cashflow fixtures", () => {
+  it.each([30, 300, 1000])("generates a finite own/team portfolio with %i contracts", contractCount => {
+    const { snapshot, statements } = makeWorkerFixture(contractCount, asOf);
+    expect(snapshot.ownEntries.length + snapshot.teamEntriesRaw.length).toBe(contractCount);
+    expect(snapshot.ownEntries.length).toBeGreaterThan(0);
+    expect(snapshot.teamEntriesRaw.length).toBeGreaterThan(0);
+    const items = computeCashflow(snapshot, { ...WORKER_FILTER_CASES[0].options, asOf });
+    expect(items.length).toBeGreaterThan(contractCount);
+    expect(items.every(item => Number.isFinite(item.amount) && Number.isFinite(item.date.getTime()))).toBe(true);
+    expect(items.some(item => item.source === "manager")).toBe(true);
+    expect(items.some(item => item.isTipPayout)).toBe(true);
+    expect(items.some(item => item.productKey === "neon")).toBe(true);
+    expect(items.some(item => item.productKey === "cppAuto")).toBe(true);
+    const months = buildCashflowView(items, statements, WORKER_FILTER_CASES[0].options, asOf);
+    expect(months.length).toBeGreaterThan(0);
+    expect(months.every(month => Number.isFinite(month.total))).toBe(true);
+  });
+
+  it("is deterministic, independent between calls and contains only synthetic email addresses", () => {
+    const first = makeWorkerFixture(30, asOf);
+    const second = makeWorkerFixture(30, asOf);
+    expect(first).toEqual(second);
+    const emails: string[] = [];
+    const visit = (value: unknown) => {
+      if (typeof value === "string" && value.includes("@")) emails.push(value);
+      else if (Array.isArray(value)) value.forEach(visit);
+      else if (value && typeof value === "object") Object.values(value).forEach(visit);
+    };
+    visit(first);
+    expect(emails.length).toBeGreaterThan(0);
+    expect(emails.every(email => /^[a-z0-9.-]+@example\.test$/.test(email))).toBe(true);
+    expect(first.snapshot.subscriptionPayments).toEqual([]);
+    first.snapshot.ownEntries[0].items![0].amount = -1;
+    first.statements[0].paidContractNumbers.push("mutated");
+    expect(second).toEqual(makeWorkerFixture(30, asOf));
+  });
+
+  it("exercises distinct results for every advertised filter case", () => {
+    const { snapshot, statements } = makeWorkerFixture(30, asOf);
+    const views = new Map(WORKER_FILTER_CASES.map(({ id, options }) => {
+      const items = computeCashflow(snapshot, { ...options, asOf });
+      return [id, buildCashflowView(items, statements, options, asOf)];
+    }));
+    const results = [...views.values()];
+    expect(results.every(months => months.length > 0)).toBe(true);
+    expect(new Set(results.map(months => JSON.stringify(months))).size).toBe(WORKER_FILTER_CASES.length);
+    expect(views.get("team")!.flatMap(month => month.items).every(item => item.source === "manager")).toBe(true);
+    expect(views.get("tip")!.flatMap(month => month.items).every(item => item.isTipPayout)).toBe(true);
+    expect(views.get("search")!.flatMap(month => month.items).every(item => item.contractNumber === "100000")).toBe(true);
+    expect(views.get("history")!.some(month => month.year < asOf.getFullYear())).toBe(true);
+    expect(views.get("prediction")!.flatMap(month => month.items).some(item => item.predictionAdjustment)).toBe(true);
+  });
+
+  it("scales statements and their matched contract sets without exceeding the fixture portfolio", () => {
+    const sizes = [30, 300, 1000].map(count => makeWorkerFixture(count, asOf));
+    expect(sizes.map(fixture => fixture.statements.length)).toEqual([3, 8, 24]);
+    for (const { snapshot, statements } of sizes) {
+      const numbers = new Set([...snapshot.ownEntries, ...snapshot.teamEntriesRaw].map(entry => entry.contractNumber));
+      expect(statements.every(statement => statement.paidContractNumbers.every(number => numbers.has(number)))).toBe(true);
+      expect(statements.every(statement => statement.statementDateMs! < asOf.getTime())).toBe(true);
+    }
+  });
+
+  it.each([0, -1, 1.5, 1001, Number.NaN, Number.POSITIVE_INFINITY])("rejects unsupported contract count %s", count => {
+    expect(() => makeWorkerFixture(count, asOf)).toThrow("Synthetic fixtures require");
+  });
+
+  it("rejects an invalid date", () => {
+    expect(() => makeWorkerFixture(30, new Date(Number.NaN))).toThrow("Synthetic fixtures require");
+  });
+});
diff --git a/scripts/cashflow-worker/fixtures.ts b/scripts/cashflow-worker/fixtures.ts
new file mode 100644
