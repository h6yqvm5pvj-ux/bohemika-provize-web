@@ -0,0 +1,88 @@
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import * as computation from "../../src/app/cashflow/computeCashflow";
+import * as view from "../../src/app/cashflow/buildCashflowView";
+import * as generator from "../../src/app/cashflow/generator";
+import { cashflowCanonicalJson } from "../../src/app/cashflow/shadowProtocol";
+import { defaultBase, generateReference } from "./generate-reference.mjs";
+import { makeWorkerFixture, WORKER_FILTER_CASES } from "./fixtures";
+import {
+  REFERENCE_PROVENANCE, runCandidate, runReference, runReferenceItems, runReferenceView,
+} from "./reference";
+
+const asOf = new Date(2026, 8, 12, 12);
+const digest = (value: unknown) => createHash("sha256").update(cashflowCanonicalJson(value)).digest("hex");
+afterEach(() => { vi.restoreAllMocks(); vi.useRealTimers(); });
+
+describe("independent production cashflow benchmark reference", () => {
+  it("is exactly reproducible from the immutable hook/page AST", () => {
+    const source = readFileSync(new URL("./reference.ts", import.meta.url), "utf8");
+    expect(digest(source)).toBe(digest(generateReference(defaultBase)));
+    for (const [relative, expected] of Object.entries(REFERENCE_PROVENANCE.sources)) {
+      const base = readFileSync(path.join(defaultBase, relative));
+      const work = readFileSync(path.resolve(fileURLToPath(new URL("../..", import.meta.url)), relative));
+      expect(createHash("sha256").update(base).digest("hex")).toBe(expected);
+      expect(createHash("sha256").update(work).digest("hex")).toBe(expected);
+    }
+  });
+
+  it("does not call either candidate composition function", () => {
+    const compute = vi.spyOn(computation, "computeCashflow").mockImplementation(() => { throw new Error("Candidate sentinel"); });
+    const build = vi.spyOn(view, "buildCashflowView").mockImplementation(() => { throw new Error("Candidate view sentinel"); });
+    const fixture = makeWorkerFixture(30, asOf);
+    expect(runReference(fixture.snapshot, fixture.statements, WORKER_FILTER_CASES[0].options, asOf).items.length).toBeGreaterThan(0);
+    expect(compute).not.toHaveBeenCalled();
+    expect(build).not.toHaveBeenCalled();
+    expect(() => runCandidate(fixture.snapshot, fixture.statements, WORKER_FILTER_CASES[0].options, asOf)).toThrow("Candidate sentinel");
+  });
+
+  for (const count of [30, 300, 1000]) {
+    it.each(WORKER_FILTER_CASES)(`matches the full item/month fingerprint for ${count} contracts and $id`, ({ options }) => {
+      const fixture = makeWorkerFixture(count, asOf);
+      const before = digest(fixture);
+      const reference = runReference(fixture.snapshot, fixture.statements, options, asOf);
+      const candidate = runCandidate(fixture.snapshot, fixture.statements, options, asOf);
+      expect(reference.items.length).toBeGreaterThan(0);
+      expect(reference.months.length).toBeGreaterThan(0);
+      // Fingerprints avoid dumping portfolios into failed-test logs.
+      expect(digest(candidate)).toBe(digest(reference));
+      expect(digest(fixture)).toBe(before);
+    });
+  }
+
+  it("reuses generated items when only search, history or prediction changes", () => {
+    const fixture = makeWorkerFixture(30, asOf);
+    const generate = vi.spyOn(generator, "generateCashflow");
+    const items = runReferenceItems(fixture.snapshot, WORKER_FILTER_CASES[0].options, asOf);
+    for (const selected of WORKER_FILTER_CASES.filter(item => ["search", "history", "prediction"].includes(item.id))) {
+      const months = runReferenceView(items, fixture.statements, selected.options, asOf);
+      expect(digest(months)).toBe(digest(view.buildCashflowView(items, fixture.statements, selected.options, asOf)));
+    }
+    expect(generate).toHaveBeenCalledTimes(1);
+  });
+
+  it("freezes the captured clock without depending on the test process date", () => {
+    const fixture = makeWorkerFixture(30, asOf);
+    const options = WORKER_FILTER_CASES.find(item => item.id === "prediction")!.options;
+    vi.useFakeTimers();
+    vi.setSystemTime(asOf);
+    const baseline = digest(runReference(fixture.snapshot, fixture.statements, options, asOf));
+    vi.setSystemTime(new Date(2036, 0, 1));
+    expect(digest(runReference(fixture.snapshot, fixture.statements, options, asOf))).toBe(baseline);
+  });
+
+  it("preserves Date fields through structured cloning of input and complete output", () => {
+    const fixture = makeWorkerFixture(30, asOf);
+    const options = WORKER_FILTER_CASES[0].options;
+    const expected = runReference(fixture.snapshot, fixture.statements, options, asOf);
+    const copy = structuredClone({ ...fixture, options, asOf });
+    const actual = structuredClone(runCandidate(copy.snapshot, copy.statements, copy.options, copy.asOf));
+    expect(digest(actual)).toBe(digest(expected));
+    expect(actual.items[0].date).toBeInstanceOf(Date);
+    expect(actual.months[0].items[0].date).toBeInstanceOf(Date);
+    expect(typeof JSON.parse(JSON.stringify(actual)).items[0].date).toBe("string");
+  });
+});
