+import { createCashflowWorkerClient, type CashflowWorkerInput, type CashflowWorkerResult } from "./client";
+import { makeWorkerFixture, WORKER_FILTER_CASES, type WorkerFixture } from "./fixtures";
+import { runReference, runReferenceItems, runReferenceView, runCandidate } from "./reference";
+import { calibrateCpu } from "./calibration";
+
+const asOf = new Date("2026-09-12T12:00:00.000Z");
+let fixture: WorkerFixture;
+let referenceItems: CashflowWorkerResult["items"];
+let client = newClient();
+const tasks: { start: number; duration: number }[] = [];
+const observer = new PerformanceObserver(list => {
+  for (const entry of list.getEntries()) tasks.push({ start: entry.startTime, duration: entry.duration });
+});
+if (PerformanceObserver.supportedEntryTypes.includes("longtask")) observer.observe({ type: "longtask", buffered: true });
+const nextFrame = () => new Promise<number>(resolve => requestAnimationFrame(resolve));
+const pauseFrame = async () => { await nextFrame(); await nextFrame(); };
+function newClient(url = "/worker.js", timeoutMs = 30_000, allowFallback = false) {
+  return createCashflowWorkerClient({
+    createWorker: () => new Worker(url, { type: "module" }),
+    fallback: input => {
+      if (!allowFallback) throw new Error("Measured worker path failed");
+      return runReference(input.snapshot, input.statements, input.options, input.asOf);
+    },
+    timeoutMs,
+  });
+}
+function inputFor(caseId: string): CashflowWorkerInput {
+  const selected = WORKER_FILTER_CASES.find(item => item.id === caseId);
+  if (!selected) throw new Error("Unknown synthetic filter");
+  return { ...fixture, options: { ...selected.options }, asOf };
+}
+function canonical(value: unknown): string {
+  if (value instanceof Date) return `date:${value.toISOString()}`;
+  if (value === undefined) return "undefined";
+  if (value === null) return "null";
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) throw new Error("Non-finite synthetic result");
+    return `number:${Object.is(value, -0) ? "-0" : value}`;
+  }
+  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+  if (typeof value === "object") return `{${Object.entries(value).sort(([a],[b]) => a.localeCompare(b))
+    .map(([key,item]) => `${JSON.stringify(key)}:${canonical(item)}`).join(",")}}`;
+  return `${typeof value}:${JSON.stringify(value)}`;
+}
+async function fingerprint(value: unknown) {
+  const bytes = new TextEncoder().encode(canonical(value));
+  const hash = await crypto.subtle.digest("SHA-256", bytes);
+  return [...new Uint8Array(hash)].map(byte => byte.toString(16).padStart(2,"0")).join("");
+}
+function reference(input: CashflowWorkerInput, viewOnly: boolean) {
+  return viewOnly
+    ? { items: referenceItems, months: runReferenceView(referenceItems, input.statements, input.options, asOf) }
+    : runReference(input.snapshot, input.statements, input.options, asOf);
+}
+async function prepare(count: number) {
+  client.dispose();
+  client = newClient();
+  fixture = makeWorkerFixture(count, asOf);
+  const input = inputFor("combined");
+  referenceItems = runReferenceItems(input.snapshot, input.options, asOf);
+  // Warm initialization is separate from steady-state filter timings.
+  const started = performance.now();
+  const result = await client.run(input);
+  const firstWorkerRoundtripMs = performance.now() - started;
+  const expected = runReference(input.snapshot, input.statements, input.options, asOf);
+  if (canonical(result) !== canonical(expected)) throw new Error("Initial worker mismatch");
+  await pauseFrame();
+  return { contracts: count, items: result.items.length, months: result.months.length, firstWorkerRoundtripMs,
+    inputJsonBytes: new TextEncoder().encode(JSON.stringify(input)).length,
+    resultJsonBytes: new TextEncoder().encode(JSON.stringify(result)).length };
+}
+async function verify(caseId: string) {
+  const input = inputFor(caseId);
+  const before = canonical(input);
+  const expected = runReference(input.snapshot, input.statements, input.options, asOf);
+  const candidate = runCandidate(input.snapshot, input.statements, input.options, asOf);
+  const result = await client.run(input);
+  const matched = canonical(expected) === canonical(candidate) && canonical(expected) === canonical(result);
+  const inputUnchanged = canonical(input) === before;
+  if (!matched || !inputUnchanged) throw new Error(`Synthetic mismatch: ${caseId}`);
+  return { caseId, matched, inputUnchanged, items: result.items.length, months: result.months.length,
+    fingerprint: await fingerprint(result) };
+}
+async function measure(mode: "main" | "worker", caseId: string, viewOnly: boolean) {
+  const input = inputFor(caseId);
+  if (viewOnly && !["search", "prediction", "history", "combined"].includes(caseId)) throw new Error("Invalid view-only scenario");
+  await pauseFrame();
+  tasks.length = 0;
+  const frameGaps: number[] = [];
+  let active = true;
+  let lastFrame = performance.now();
+  function frame(now: number) {
+    frameGaps.push(now - lastFrame);
+    lastFrame = now;
+    if (active) requestAnimationFrame(frame);
+  }
+  requestAnimationFrame(frame);
+  const started = performance.now();
+  const timer = new Promise<number>(resolve => setTimeout(() => resolve(performance.now() - started), 0));
+  const result = mode === "main" ? reference(input, viewOnly) : await client.run(input);
+  const finished = performance.now();
+  const timerDelayMs = await timer;
+  await pauseFrame();
+  active = false;
+  const longTasks = tasks.filter(task => task.start < finished && task.start + task.duration > started);
+  return { mode, caseId, viewOnly, work: mode === "worker" ? "full-compute-and-view" : viewOnly ? "view-from-cached-items-without-React-memoization" : "full-reference-compute-and-view", elapsedMs: finished - started, timerDelayMs,
+    maxFrameGapMs: Math.max(0, ...frameGaps), longTaskCount: longTasks.length,
+    maxLongTaskMs: Math.max(0, ...longTasks.map(task => task.duration)),
+    items: result.items.length, months: result.months.length };
+}
+async function controls() {
+  const input = inputFor("combined");
+  const first = client.run(input).then(() => false, error => error.name === "AbortError");
+  const second = client.run(inputFor("life"));
+  const newest = await second;
+  const newestExpected = runReference(fixture.snapshot, fixture.statements, inputFor("life").options, asOf);
+  const latestOnly = await first && canonical(newest) === canonical(newestExpected);
+  const disposed = newClient();
+  const pending = disposed.run(input).then(() => false, error => error.name === "AbortError");
+  disposed.dispose();
+  const disposeAborted = await pending;
+  const disposeRejectsNew = await disposed.run(input).then(() => false, error => error.name === "AbortError");
+  const checks: Record<string, boolean> = { latestOnly, disposeAborted, disposeRejectsNew };
+  for (const [name, url, timeoutMs] of [["crashFallback", "/worker-error.js", 5000], ["timeoutFallback", "/worker-silent.js", 20]] as const) {
+    const broken = newClient(url, timeoutMs, true);
+    const result = await broken.run(input);
+    checks[name] = canonical(result) === canonical(runReference(input.snapshot, input.statements, input.options, asOf));
+    broken.dispose();
+  }
+  const unavailable = createCashflowWorkerClient({createWorker: () => { throw new Error("Synthetic unavailable"); },
+    fallback: value => runReference(value.snapshot,value.statements,value.options,value.asOf)});
+  checks.unavailableFallback = canonical(await unavailable.run(input)) === canonical(runReference(input.snapshot,input.statements,input.options,asOf));
+  unavailable.dispose();
+  if (Object.values(checks).some(value => !value)) throw new Error("Browser lifecycle check failed");
+  return checks;
+}
+async function calibration() {
+  const worker = new Worker("/worker.js", { type: "module" });
+  const main: number[] = [], background: number[] = [];
+  try {
+    for (let index = 0; index < 5; index += 1) {
+      const result = calibrateCpu();
+      const remote = await new Promise<{ elapsedMs: number; checksum: number }>((resolve, reject) => {
+        const timer = setTimeout(() => reject(new Error("Calibration timeout")), 10_000);
+        worker.onmessage = event => { clearTimeout(timer); resolve(event.data.calibration); };
+        worker.onerror = () => { clearTimeout(timer); reject(new Error("Calibration failed")); };
+        worker.postMessage({id:index,kind:"calibrate"});
+      });
+      if (result.checksum !== remote.checksum) throw new Error("Calibration checksum mismatch");
+      if (index > 0) { main.push(result.elapsedMs); background.push(remote.elapsedMs); }
+    }
+  } finally { worker.terminate(); }
+  return { mainMs: main, workerMs: background };
+}
+Object.assign(window, { workerBenchmark: { prepare, verify, measure, controls, calibration,
+  cases: WORKER_FILTER_CASES.map(({id,label}) => ({id,label})),
+  dispose: () => { client.dispose(); observer.disconnect(); } } });
