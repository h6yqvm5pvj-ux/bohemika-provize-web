@@ -0,0 +1,144 @@
+import type { CashflowSnapshot } from "../../src/app/cashflow/computeCashflow";
+import type { CashflowViewOptions } from "../../src/app/cashflow/buildCashflowView";
+import type { CashflowCommissionStatementSummary, CashflowItem, MonthGroup } from "../../src/app/cashflow/types";
+
+export type CashflowWorkerInput = {
+  snapshot: CashflowSnapshot;
+  statements: CashflowCommissionStatementSummary[];
+  options: CashflowViewOptions;
+  asOf: Date;
+};
+export type CashflowWorkerResult = { items: CashflowItem[]; months: MonthGroup[] };
+export type CashflowWorkerPort = Pick<Worker, "postMessage" | "addEventListener" | "removeEventListener" | "terminate">;
+export type CashflowWorkerClient = {
+  run(input: CashflowWorkerInput): Promise<CashflowWorkerResult>;
+  dispose(): void;
+};
+
+type PendingRequest = {
+  id: number;
+  input: CashflowWorkerInput;
+  resolve: (result: CashflowWorkerResult) => void;
+  reject: (error: Error) => void;
+  timer: ReturnType<typeof setTimeout>;
+};
+
+/** Benchmark-only client. The owner must keep each submitted input immutable. */
+export function createCashflowWorkerClient({ createWorker, fallback, timeoutMs = 30_000 }: {
+  createWorker: () => CashflowWorkerPort;
+  fallback: (input: CashflowWorkerInput) => CashflowWorkerResult;
+  timeoutMs?: number;
+}): CashflowWorkerClient {
+  if (!Number.isFinite(timeoutMs) || timeoutMs <= 0 || timeoutMs > 2_147_483_647) {
+    throw new RangeError("Invalid worker timeout");
+  }
+  let worker: CashflowWorkerPort | null = null;
+  let workerFailed = false;
+  let disposed = false;
+  let sequence = 0;
+  let pending: PendingRequest | null = null;
+
+  const clear = (request: PendingRequest) => {
+    clearTimeout(request.timer);
+    if (pending === request) pending = null;
+  };
+  const abortPending = () => {
+    if (!pending) return;
+    const request = pending;
+    clear(request);
+    request.reject(new DOMException("Cashflow request was cancelled", "AbortError"));
+  };
+  const stopWorker = () => {
+    const previous = worker;
+    worker = null;
+    if (!previous) return;
+    // Cleanup failures must not prevent cancellation or the reference fallback.
+    try { previous.removeEventListener("message", onMessage); } catch { /* Best effort. */ }
+    try { previous.removeEventListener("error", onFailure); } catch { /* Best effort. */ }
+    try { previous.removeEventListener("messageerror", onFailure); } catch { /* Best effort. */ }
+    try { previous.terminate(); } catch { /* Best effort. */ }
+  };
+  const runFallback = () => {
+    const request = pending;
+    if (!request || disposed) return;
+    clearTimeout(request.timer);
+    try {
+      const result = fallback(request.input);
+      // A reentrant run/dispose from the injected fallback also invalidates it.
+      if (pending !== request || disposed) return;
+      clear(request);
+      request.resolve(result);
+    } catch {
+      if (pending !== request || disposed) return;
+      clear(request);
+      request.reject(new Error("Cashflow calculation failed"));
+    }
+  };
+  function onFailure(event?: Event) {
+    // Suppress the browser's default logging of an uncaught worker error.
+    event?.preventDefault?.();
+    if (disposed || workerFailed) return;
+    workerFailed = true;
+    stopWorker();
+    runFallback();
+  }
+  function onMessage(event: MessageEvent<unknown>) {
+    if (disposed || workerFailed || !pending) return;
+    const data = event.data;
+    if (!data || typeof data !== "object" || Array.isArray(data)) {
+      onFailure();
+      return;
+    }
+    const message = data as Record<string, unknown>;
+    if (typeof message.id !== "number" || !Number.isSafeInteger(message.id) ||
+      message.id <= 0 || message.id > pending.id) {
+      onFailure();
+      return;
+    }
+    if (message.id < pending.id) return;
+    const result = message.result;
+    if (message.ok !== true || !result || typeof result !== "object" ||
+      !Array.isArray((result as CashflowWorkerResult).items) ||
+      !Array.isArray((result as CashflowWorkerResult).months)) {
+      onFailure();
+      return;
+    }
+    const request = pending;
+    clear(request);
+    request.resolve(result as CashflowWorkerResult);
+  }
+
+  return {
+    run(input) {
+      if (disposed) return Promise.reject(new DOMException("Cashflow client was disposed", "AbortError"));
+      abortPending();
+      return new Promise<CashflowWorkerResult>((resolve, reject) => {
+        const id = ++sequence;
+        pending = { id, input, resolve, reject, timer: setTimeout(() => {
+          if (pending?.id === id) onFailure();
+        }, timeoutMs) };
+        if (workerFailed) {
+          runFallback();
+          return;
+        }
+        try {
+          if (!worker) {
+            worker = createWorker();
+            worker.addEventListener("message", onMessage);
+            worker.addEventListener("error", onFailure);
+            worker.addEventListener("messageerror", onFailure);
+          }
+          worker.postMessage({ id, input });
+        } catch {
+          onFailure();
+        }
+      });
+    },
+    dispose() {
+      if (disposed) return;
+      disposed = true;
+      abortPending();
+      stopWorker();
+    },
+  };
+}
