+import { afterEach, beforeEach, describe, expect, expectTypeOf, it, vi } from "vitest";
+import {
+  createCashflowWorkerClient,
+  type CashflowWorkerInput,
+  type CashflowWorkerPort,
+  type CashflowWorkerResult,
+} from "./client";
+
+function fakeWorker() {
+  const listeners = new Map<string, Set<(event: unknown) => void>>();
+  return {
+    postMessage: vi.fn(),
+    terminate: vi.fn(),
+    addEventListener: vi.fn((name: string, listener: (event: unknown) => void) => {
+      const current = listeners.get(name) ?? new Set();
+      current.add(listener);
+      listeners.set(name, current);
+    }),
+    removeEventListener: vi.fn((name: string, listener: (event: unknown) => void) => {
+      listeners.get(name)?.delete(listener);
+    }),
+    emit(name: string, data?: unknown) {
+      const event = { data, preventDefault: vi.fn() };
+      [...(listeners.get(name) ?? [])].forEach(listener => listener(event));
+      return event;
+    },
+  };
+}
+
+const input = (): CashflowWorkerInput => ({
+  snapshot: {
+    email: "advisor@example.test", myPosition: null, myCommissionMode: null,
+    hasAnyTeam: false, ownEntries: [], teamEntriesRaw: [], tipPayouts: [], subscriptionPayments: [],
+  },
+  statements: [],
+  options: {
+    scopeFilter: "combined", productFilter: "all", tipsterMode: false,
+    showPastYears: false, intelligentPredictionEnabled: false, contractNumberQuery: "",
+  },
+  asOf: new Date("2026-09-12T12:00:00Z"),
+});
+const result = (): CashflowWorkerResult => ({ items: [], months: [] });
+
+function fixture(timeoutMs?: number) {
+  const worker = fakeWorker();
+  const createWorker = vi.fn(() => worker as unknown as CashflowWorkerPort);
+  const fallback = vi.fn<(input: CashflowWorkerInput) => CashflowWorkerResult>(() => result());
+  const client = createCashflowWorkerClient({ createWorker, fallback, timeoutMs });
+  return { worker, createWorker, fallback, client };
+}
+
+beforeEach(() => vi.useFakeTimers());
+afterEach(() => { vi.useRealTimers(); vi.restoreAllMocks(); });
+
+describe("cashflow worker benchmark client", () => {
+  it("starts lazily, transfers the supplied context and preserves structured Date results", async () => {
+    expectTypeOf<Worker>().toExtend<CashflowWorkerPort>();
+    const { worker, createWorker, fallback, client } = fixture();
+    expect(createWorker).not.toHaveBeenCalled();
+    const args = input();
+    const before = structuredClone(args);
+    const pending = client.run(args);
+    expect(worker.postMessage).toHaveBeenCalledWith({ id: 1, input: args });
+    const output = result();
+    output.items.push({ id: "item", amount: 125, productKey: "cppAuto", date: args.asOf,
+      ownerEmail: args.snapshot.email, entryId: "entry" });
+    worker.emit("message", { id: 1, ok: true, result: output });
+    expect(await pending).toBe(output);
+    expect(output.items[0].date).toBeInstanceOf(Date);
+    expect(args).toEqual(before);
+    expect(fallback).not.toHaveBeenCalled();
+    expect(vi.getTimerCount()).toBe(0);
+    const next = client.run(args);
+    worker.emit("message", { id: 2, ok: true, result: output });
+    expect(await next).toBe(output);
+    expect(createWorker).toHaveBeenCalledTimes(1);
+    client.dispose();
+  });
+
+  it("rejects superseded work and ignores its later successes and failures", async () => {
+    const { worker, fallback, client } = fixture();
+    const first = client.run(input());
+    const rejected = expect(first).rejects.toMatchObject({ name: "AbortError" });
+    const second = client.run(input());
+    await rejected;
+    const resolved = vi.fn();
+    void second.then(resolved);
+    worker.emit("message", { id: 1, ok: true, result: result() });
+    worker.emit("message", { id: 1, ok: false });
+    await Promise.resolve();
+    expect(resolved).not.toHaveBeenCalled();
+    expect(fallback).not.toHaveBeenCalled();
+    const output = result();
+    worker.emit("message", { id: 2, ok: true, result: output });
+    expect(await second).toBe(output);
+    expect(worker.terminate).not.toHaveBeenCalled();
+    client.dispose();
+  });
+
+  it.each(["error", "messageerror", "reported", "malformed"])("falls back only for the current request after %s and retires the failed worker", async kind => {
+    const { worker, createWorker, fallback, client } = fixture();
+    const first = client.run(input());
+    const rejected = expect(first).rejects.toMatchObject({ name: "AbortError" });
+    const currentInput = input();
+    currentInput.options.productFilter = "life";
+    const latest = client.run(currentInput);
+    await rejected;
+    if (kind === "reported") worker.emit("message", { id: 2, ok: false });
+    else if (kind === "malformed") worker.emit("message", { id: 2, ok: true, result: { items: "bad", months: [] } });
+    else expect(worker.emit(kind).preventDefault).toHaveBeenCalledOnce();
+    expect(await latest).toEqual(result());
+    expect(fallback).toHaveBeenCalledExactlyOnceWith(currentInput);
+    expect(worker.terminate).toHaveBeenCalledTimes(1);
+    expect(worker.removeEventListener).toHaveBeenCalledTimes(3);
+    expect(vi.getTimerCount()).toBe(0);
+    worker.emit("message", { id: 2, ok: true, result: result() });
+    expect(fallback).toHaveBeenCalledTimes(1);
+    expect(await client.run(input())).toEqual(result());
+    expect(fallback).toHaveBeenCalledTimes(2);
+    expect(createWorker).toHaveBeenCalledTimes(1);
+    client.dispose();
+    expect(worker.terminate).toHaveBeenCalledTimes(1);
+  });
+
+  it("uses the default 30-second timeout and clears it after fallback", async () => {
+    const { client, fallback, worker } = fixture();
+    const pending = client.run(input());
+    vi.advanceTimersByTime(29_999);
+    expect(fallback).not.toHaveBeenCalled();
+    vi.advanceTimersByTime(1);
+    expect(await pending).toEqual(result());
+    expect(fallback).toHaveBeenCalledTimes(1);
+    expect(worker.terminate).toHaveBeenCalledTimes(1);
+    expect(vi.getTimerCount()).toBe(0);
+    client.dispose();
+  });
+
+  it.each([null, [], "Private payload", {}, { id: "1" }, { id: 0 }, { id: 1.5 }, { id: 2 }])("falls back promptly for an invalid response without a valid request identity: %j", message => {
+    const { client, worker, fallback } = fixture();
+    const args = input();
+    const pending = client.run(args);
+    worker.emit("message", message);
+    expect(fallback).toHaveBeenCalledExactlyOnceWith(args);
+    expect(worker.terminate).toHaveBeenCalledTimes(1);
+    expect(vi.getTimerCount()).toBe(0);
+    client.dispose();
+    return expect(pending).resolves.toEqual(result());
+  });
+
+  it("replaces the timeout together with the request", async () => {
+    const { client, fallback } = fixture(100);
+    const first = client.run(input());
+    const rejected = expect(first).rejects.toMatchObject({ name: "AbortError" });
+    vi.advanceTimersByTime(90);
+    const currentInput = input();
+    const latest = client.run(currentInput);
+    await rejected;
+    vi.advanceTimersByTime(10);
+    expect(fallback).not.toHaveBeenCalled();
+    vi.advanceTimersByTime(90);
+    expect(await latest).toEqual(result());
+    expect(fallback).toHaveBeenCalledExactlyOnceWith(currentInput);
+    client.dispose();
+  });
+
+  it.each(["factory", "postMessage", "listener"])("uses the synchronous fallback when %s throws, without exposing error contents", async kind => {
+    const { worker, createWorker, fallback, client } = fixture();
+    const fail = () => { throw new Error("Private financial payload"); };
+    if (kind === "factory") createWorker.mockImplementation(fail);
+    if (kind === "postMessage") worker.postMessage.mockImplementation(fail);
+    if (kind === "listener") worker.addEventListener.mockImplementation(fail);
+    const args = input();
+    expect(await client.run(args)).toEqual(result());
+    expect(fallback).toHaveBeenCalledExactlyOnceWith(args);
+    expect(worker.terminate).toHaveBeenCalledTimes(kind === "factory" ? 0 : 1);
+    client.dispose();
+  });
+
+  it("sanitizes a failing fallback and leaves no pending timer", async () => {
+    const { client, worker, fallback } = fixture();
+    fallback.mockImplementation(() => { throw new Error("Private financial payload"); });
+    const pending = client.run(input());
+    const rejected = expect(pending).rejects.toThrow("Cashflow calculation failed");
+    worker.emit("error");
+    await rejected;
+    expect(vi.getTimerCount()).toBe(0);
+    client.dispose();
+  });
+
+  it("disposes pending work, removes listeners, terminates once and rejects future runs", async () => {
+    const { client, worker, fallback, createWorker } = fixture();
+    const pending = client.run(input());
+    const rejected = expect(pending).rejects.toMatchObject({ name: "AbortError" });
+    client.dispose();
+    client.dispose();
+    await rejected;
+    worker.emit("message", { id: 1, ok: true, result: result() });
+    worker.emit("error");
+    vi.advanceTimersByTime(60_000);
+    expect(fallback).not.toHaveBeenCalled();
+    expect(worker.terminate).toHaveBeenCalledTimes(1);
+    expect(worker.removeEventListener).toHaveBeenCalledTimes(3);
+    expect(vi.getTimerCount()).toBe(0);
+    await expect(client.run(input())).rejects.toMatchObject({ name: "AbortError" });
+    expect(createWorker).toHaveBeenCalledTimes(1);
+  });
+
+  it("can be disposed before the first run without constructing a worker", async () => {
+    const { client, createWorker, fallback } = fixture();
+    client.dispose();
+    await expect(client.run(input())).rejects.toMatchObject({ name: "AbortError" });
+    expect(createWorker).not.toHaveBeenCalled();
+    expect(fallback).not.toHaveBeenCalled();
+  });
+
+  it("does not let a reentrant disposal inside fallback settle an obsolete request", async () => {
+    const { client, worker, fallback } = fixture();
+    fallback.mockImplementation(() => { client.dispose(); return result(); });
+    const pending = client.run(input());
+    const rejected = expect(pending).rejects.toMatchObject({ name: "AbortError" });
+    worker.emit("error");
+    await rejected;
+    expect(vi.getTimerCount()).toBe(0);
+  });
+
+  it("does not let a reentrant newer fallback be overwritten by an older result", async () => {
+    const { client, worker, fallback } = fixture();
+    const newerResult = result();
+    const olderResult = result();
+    let newer: Promise<CashflowWorkerResult> | undefined;
+    fallback.mockImplementationOnce(() => {
+      newer = client.run(input());
+      return olderResult;
+    }).mockReturnValue(newerResult);
+    const pending = client.run(input());
+    const rejected = expect(pending).rejects.toMatchObject({ name: "AbortError" });
+    worker.emit("error");
+    await rejected;
+    expect(await newer).toBe(newerResult);
+    expect(fallback).toHaveBeenCalledTimes(2);
+    expect(vi.getTimerCount()).toBe(0);
+    client.dispose();
+  });
+
+  it.each([0, -1, NaN, Infinity, 2_147_483_648])("rejects invalid timeout %s before starting any work", timeoutMs => {
+    expect(() => fixture(timeoutMs)).toThrow(RangeError);
+  });
+});
