+    await settleSummaries();
+    await act(async () => root!.unmount());
+    root = null;
+    await act(async () => tipCalls()[0].job.resolve(currentTips()));
+    expect(tipCalls()[0].signal?.aborted).toBe(true);
+    expect(mocks.write).not.toHaveBeenCalled();
+  });
+});
