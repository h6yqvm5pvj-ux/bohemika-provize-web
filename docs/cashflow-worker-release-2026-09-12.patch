+    })),
+    detail: detail ? { title: text(detail.querySelector("h3")), textLength: detailText.length, fingerprint: await digest(detailText) } : null,
+    textFingerprint: await digest(pageText),
+    network,
+    execution,
+  };
+}
+
+async function waitUntilReady(timeoutMs = 15_000) {
+  const deadline = performance.now() + timeoutMs;
+  await wait(0); // Let the actual page effects and discrete events commit.
+  while (performance.now() < deadline) {
+    await nextFrame();
+    if (busy()) continue;
+    await nextFrame();
+    if (!busy()) return;
+  }
+  throw new Error("Synthetic cashflow UI did not settle");
+}
+
+async function settle(timeoutMs = 15_000) {
+  await waitUntilReady(timeoutMs);
+  return read();
+}
+
+const scopeLabels: Record<string, string> = { combined: "Všechny", own: "Vlastní", team: "Týmové" };
+const productLabels: Record<string, string> = { all: "Všechny", auto: "Auto", life: "Život", tip: "TIP" };
+function clickGroup(label: string, value: string) {
+  const group = host.querySelector(`[role="group"][aria-label="${label}"]`);
+  const button = [...group?.querySelectorAll<HTMLButtonElement>("button") ?? []].find(item => text(item) === value);
+  if (!button || button.disabled) throw new Error("Requested cashflow filter is unavailable");
+  button.click();
+}
+function search(value: string) {
+  const input = host.querySelector<HTMLInputElement>('input[type="search"]');
+  if (!input) throw new Error("Cashflow search is unavailable");
+  Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!.call(input, value);
+  input.dispatchEvent(new Event("input", { bubbles: true }));
+}
+type Action = { type: "scope" | "product" | "search"; value: string };
+function dispatch(action: Action) {
+  if (action.type === "scope") clickGroup("Smlouvy", scopeLabels[action.value] ?? "");
+  else if (action.type === "product") clickGroup("Produkty", productLabels[action.value] ?? "");
+  else if (action.type === "search") search(action.value);
+  else throw new Error("Unknown synthetic UI action");
+}
+
+async function openMonth(year?: number, monthIndex?: number) {
+  const section = year === undefined ? host.querySelector<HTMLElement>("section[data-year]") : host.querySelector<HTMLElement>(`section[data-year="${year}"]`);
+  const toggle = section?.querySelector<HTMLButtonElement>('button[aria-controls^="cashflow-year-"]');
+  if (!section || !toggle) throw new Error("Cashflow year unavailable");
+  if (toggle.getAttribute("aria-expanded") !== "true") { toggle.click(); await settle(); }
+  const selector = monthIndex === undefined ? "button[data-month-index]:not(:disabled)" : `button[data-month-index="${monthIndex}"]:not(:disabled)`;
+  const button = section.querySelector<HTMLButtonElement>(selector);
+  if (!button) throw new Error("Cashflow month unavailable");
+  button.click();
+  return settle();
+}
+
+Object.assign(window, { cashflowUiHarness: {
+  async mount(options: { contractCount: number; email?: string }) {
+    root?.unmount();
+    contractCount = options.contractCount;
+    setSyntheticUser(options.email ?? "advisor@example.test", contractCount);
+    root = createRoot(host);
+    root.render(<CashflowPage />);
+    return settle();
+  },
+  read, settle, waitUntilReady, dispatch, search,
+  setScope: (value: string) => dispatch({ type: "scope", value }),
+  setProduct: (value: string) => dispatch({ type: "product", value }),
+  async burst(actions: Action[], intervalMs = 16) {
+    for (const action of actions) { dispatch(action); await wait(intervalMs); }
+    return settle();
+  },
+  openMonth,
+  closeMonth() { host.querySelector<HTMLButtonElement>('[aria-label="Zavřít přehled měsíce"]')?.click(); return settle(); },
+  setUser(email: string) { setSyntheticUser(email, contractCount); return settle(); },
+  logout() { setSyntheticUser(null, contractCount); return settle(); },
+  dispose() { root?.unmount(); root = null; setSyntheticUser(null); restoreEnvironment(); },
+} });
