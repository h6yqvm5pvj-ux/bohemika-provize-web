+type ExecutionPath = "pending" | "worker" | "fallback" | "disposed";
+type ObservedClient = { readonly executionPath: ExecutionPath };
+type AuditGlobal = typeof globalThis & { __cashflowUiRecordClient?: (client: ObservedClient) => void };
+const clients: WeakRef<ObservedClient>[] = [];
+
+/** The build-only factory observer retains no dataset/client strongly. */
+export function installExecutionAudit() {
+  const target = globalThis as AuditGlobal;
+  const previous = target.__cashflowUiRecordClient;
+  target.__cashflowUiRecordClient = client => { clients.push(new WeakRef(client)); };
+  return () => {
+    if (previous) target.__cashflowUiRecordClient = previous;
+    else delete target.__cashflowUiRecordClient;
+  };
+}
+
+export function readExecutionAudit() {
+  const paths = clients.map(reference => reference.deref()?.executionPath ?? "collected" as const);
+  return {
+    created: clients.length,
+    paths,
+    activePaths: paths.filter(path => path === "pending" || path === "worker" || path === "fallback"),
+    worker: paths.filter(path => path === "worker").length,
+    fallback: paths.filter(path => path === "fallback").length,
+    pending: paths.filter(path => path === "pending").length,
+    disposed: paths.filter(path => path === "disposed").length,
+    collected: paths.filter(path => path === "collected").length,
+  };
+}
