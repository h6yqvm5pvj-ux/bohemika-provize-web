+/** Synthetic CPU probe only, independent of business data. */
+export function calibrateCpu() {
+  const started = performance.now();
+  let checksum = 0;
+  for (let index = 0; index < 30_000_000; index += 1) {
+    checksum = (Math.imul(checksum ^ index, 1664525) + 1013904223) | 0;
+  }
+  return { elapsedMs: performance.now() - started, checksum };
+}
