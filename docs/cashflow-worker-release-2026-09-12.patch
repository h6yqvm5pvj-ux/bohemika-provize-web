+    const startDate = new Date(asOf.getFullYear(), asOf.getMonth() - 1 - index % 36, 1 + index % 27);
+    const immediateAmount = life ? 1200 + index % 80 * 12 : 120 + index % 80 * 3;
+    const items = life
