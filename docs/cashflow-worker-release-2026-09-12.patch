+export function runReferenceView(cashflowItems: CashflowItem[], commissionStatements: CashflowCommissionStatementSummary[], options: CashflowViewOptions, asOf: Date): MonthGroup[] {
+  const { scopeFilter, productFilter, tipsterMode: isTipsterMode, showPastYears, intelligentPredictionEnabled, contractNumberQuery } = options;
