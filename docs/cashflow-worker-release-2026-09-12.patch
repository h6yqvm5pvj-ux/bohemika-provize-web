+import { useMemo } from "react";
+import { runReferenceItems } from "../cashflow-worker/reference";
+import type { ProductFilter, ScopeFilter } from "../../src/app/cashflow/types";
+import { SYNTHETIC_AS_OF, useSyntheticState } from "./environment";
+
+type Options = {
+  userEmail: string | null;
+  scopeFilter: ScopeFilter;
+  productFilter: ProductFilter;
+  tipsterMode?: boolean;
+  enabled?: boolean;
+  deferCalculation?: boolean;
+};
+
+/** Replaces only loading. The baseline uses the extracted original calculation. */
+export function useCashflowData({ userEmail, scopeFilter, productFilter, tipsterMode = false,
+  enabled = true, deferCalculation = false }: Options) {
+  const { fixture, user } = useSyntheticState();
+  const rawSnapshot = enabled && user?.email === userEmail && fixture.snapshot.email === userEmail ? fixture.snapshot : null;
+  const calculationDeferred = Boolean(rawSnapshot && deferCalculation &&
+    rawSnapshot.ownEntries.length + rawSnapshot.teamEntriesRaw.length >= 200);
+  const calculation = useMemo(() => {
+    if (!rawSnapshot || calculationDeferred) return { cashflowItems: [], verificationInput: null };
+    const cashflowItems = runReferenceItems(rawSnapshot, {
+      scopeFilter, productFilter, tipsterMode, showPastYears: false,
+      intelligentPredictionEnabled: false, contractNumberQuery: "",
+    }, SYNTHETIC_AS_OF);
+    return { cashflowItems, verificationInput: { snapshot: rawSnapshot, asOf: SYNTHETIC_AS_OF } };
+  }, [rawSnapshot, calculationDeferred, scopeFilter, productFilter, tipsterMode]);
+  return {
+    ...calculation, rawSnapshot, calculationDeferred, loading: false, ready: true,
+    hasTeam: Boolean(rawSnapshot?.hasAnyTeam),
+    loadingProgress: { percent: 100, label: "Syntetická data připravena", detail: null },
+  };
+}
