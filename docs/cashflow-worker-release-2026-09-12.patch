+    return {
+      id: `statement-${index}`,
+      fileName: `synthetic-statement-${index}.html`,
+      statementNumber: `SYN-${index + 1}`,
+      statementDate: `${date.getDate()}.${date.getMonth() + 1}.${date.getFullYear()}`,
+      period: `${date.getMonth() + 1}/${date.getFullYear()}`,
+      advisorNumber: "synthetic",
