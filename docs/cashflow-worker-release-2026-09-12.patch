+async function digest(value: string) {
+  const bytes = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
+  return [...new Uint8Array(bytes)].map(byte => byte.toString(16).padStart(2, "0")).join("");
+}
+
+async function read() {
+  const detail = host.querySelector<HTMLButtonElement>('[aria-label="Zavřít přehled měsíce"]')?.parentElement ?? null;
+  const pageText = text(host);
+  const detailText = text(detail);
+  const execution = readExecutionAudit();
+  const network = { ...networkAudit };
+  return {
+    scope: "actual cashflow React page; synthetic auth/profile/data hook; actual components and CSS",
+    busy: busy(),
+    heading: text(host.querySelector("header h1")),
+    total: text(host.querySelector("header strong")),
+    activeScope: text(host.querySelector('[role="group"][aria-label="Smlouvy"] [aria-pressed="true"]')),
+    activeProduct: text(host.querySelector('[role="group"][aria-label="Produkty"] [aria-pressed="true"]')),
+    query: host.querySelector<HTMLInputElement>('input[type="search"]')?.value ?? null,
+    years: [...host.querySelectorAll<HTMLElement>("section[data-year]")].map(section => ({
