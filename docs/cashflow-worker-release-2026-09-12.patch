+    monthGroups: predictedMonthGroups,
+    statementsByMonthKey: periodStatementsByMonthKey,
+    enabled: useStatementPayoutTotals,
+}))();
+  return monthGroups;
+}
+
+export function runReference(snapshot: CashflowSnapshot, statements: CashflowCommissionStatementSummary[], options: CashflowViewOptions, asOf: Date): { items: CashflowItem[]; months: MonthGroup[] } {
+  const items = runReferenceItems(snapshot, options, asOf);
+  return { items, months: runReferenceView(items, statements, options, asOf) };
+}
+
+export function runCandidate(snapshot: CashflowSnapshot, statements: CashflowCommissionStatementSummary[], options: CashflowViewOptions, asOf: Date): { items: CashflowItem[]; months: MonthGroup[] } {
+  const items = computeCashflow(snapshot, { ...options, asOf });
+  return { items, months: buildCashflowView(items, statements, options, asOf) };
