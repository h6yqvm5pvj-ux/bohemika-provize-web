+// Benchmark only. No fetch, storage, credentials, or application route.
+const scope = globalThis as unknown as {
+  onmessage: ((event: MessageEvent) => void) | null;
+  postMessage: (message: unknown) => void;
+};
+scope.onmessage = (event: MessageEvent) => {
+  const request = event.data as { id: number; input: CashflowWorkerInput; kind?: string };
+  if (request.kind === "calibrate") {
+    scope.postMessage({ id: request.id, calibration: calibrateCpu() });
+    return;
+  }
+  try {
+    const { snapshot, statements, options, asOf } = request.input;
+    const items = computeCashflow(snapshot, { ...options, asOf });
+    const months = buildCashflowView(items, statements, options, asOf);
+    scope.postMessage({ id: request.id, ok: true, result: { items, months } });
+  } catch {
+    scope.postMessage({ id: request.id, ok: false });
+  }
+};
